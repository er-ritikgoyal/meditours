---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import OurStory from '../components/OurStory.astro';
import OurJourney from '../components/OurJourney.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CostEstimateCta from '../components/CostEstimateCta.astro';
import SeoContent from '../components/SeoContent.astro';

const aboutFaqs = [
	{
		question: 'Why is India popular for medical tourism?',
		answer:
			'India attracts international patients because of its established hospitals, experienced medical specialists, healthcare facilities, and diverse medical treatment options.',
	},
	{
		question: 'How can I find the best hospital for medical tourism in India?',
		answer:
			"You should compare hospital accreditation, doctors' experience, available medical facilities, treatment plans, and patient support services before choosing a hospital.",
	},
	{
		question: 'What documents are required for medical treatment in India?',
		answer:
			'Patients may need medical reports, previous prescriptions, diagnostic records, a valid passport, and applicable visa documents. Requirements depend on the hospital and visa regulations.',
	},
	{
		question: 'Does ALIS PRO MEDI TOURS provide medical visa assistance?',
		answer: 'Yes, ALIS PRO MEDI TOURS assists international patients with medical visa arrangements as part of its medical tourism facilitation services.',
	},
	{
		question: 'Does ALIS PRO MEDI TOURS arrange accommodation and airport transfers?',
		answer: 'Yes, we assist international patients with accommodation, airport transfers, flight arrangements, and other travel coordination services.',
	},
	{
		question: 'Can international patients get a second medical opinion in India?',
		answer:
			'Yes, international patients can request a second medical opinion from relevant medical specialists in India. ALIS PRO MEDI TOURS assists with coordinating the consultation process.',
	},
	{
		question: 'How can I contact ALIS PRO MEDI TOURS for medical tourism services?',
		answer:
			'International patients can contact ALIS PRO MEDI TOURS to discuss their medical requirements and receive assistance with consultations, hospital appointments, treatment planning, and travel arrangements.',
	},
];
---

<Layout
	title="About AlisPro MediTours | Trusted Medical Tourism Company in India"
	description="Learn about AlisPro MediTours, a medical tourism company connecting international patients with accredited hospitals and experienced specialists in India."
	alternates={[
		{ locale: 'en', href: '/about' },
		{ locale: 'fr', href: '/fr/about' },
		{ locale: 'ru', href: '/ru/about' },
		{ locale: 'bn', href: '/bn/about' },
		{ locale: 'ro', href: '/ro/about' },
		{ locale: 'es', href: '/es/about' },
		{ locale: 'pt', href: '/pt/about' },
		{ locale: 'vi', href: '/vi/about' },
		{ locale: 'ar', href: '/ar/about' },
	]}
>
	<PageHeader
		badge="Since Day One"
		title="Who We Are,"
		highlight="and Why It Matters"
		subtitle="We're a team of patient coordinators, medical reviewers, and logistics specialists who believe world-class care shouldn't depend on where you live."
		breadcrumbs={[{ label: 'About' }]}
	/>

	<OurStory />
	<OurJourney />
	<!-- <WhyChooseUs
		badge="What Sets Us Apart"
		title="How We Support"
		highlight="Every Patient"
		subtitle="The same standards we hold ourselves to on every single case, for every single patient."
	/> -->
	<SeoContent />

	<FaqAccordion
		badge="FAQs"
		title="Medical Tourism in India,"
		highlight="Answered"
		subtitle="Common questions international patients ask before travelling to India for treatment."
		faqs={aboutFaqs}
	/>

	<CostEstimateCta />
	
</Layout>

<style>
	.about-cta {
		background: var(--gradient-premium);
		padding: 72px 24px;
		text-align: center;
		font-family: var(--font-body);
	}

	.about-cta__inner {
		max-width: 620px;
		margin: 0 auto;
	}

	.about-cta h2 {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 2.6vw, 2rem);
		font-weight: 700;
		color: #ffffff;
		margin: 0;
	}

	.about-cta p {
		margin: 14px 0 0;
		font-size: 15px;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.8);
	}

	.about-cta__btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 28px;
		padding: 13px 28px;
		border-radius: var(--radius-md);
		background: #ffffff;
		color: var(--color-primary);
		font-size: 14.5px;
		font-weight: 600;
		text-decoration: none;
		transition: transform 0.15s ease;
	}

	.about-cta__btn:hover {
		transform: translateY(-2px);
	}

	.about-cta__btn :global(svg) {
		width: 18px;
		height: 18px;
	}
</style>
