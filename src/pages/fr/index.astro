---
import { doctorVideoUrls } from '../../data/doctors';
import HeroSection from '../../components/HeroSection.astro';
import Achievements from '../../components/Achievements.astro';
import TravelProcess from '../../components/TravelProcess.astro';
import WhyChooseUs from '../../components/WhyChooseUs.astro';
import DoctorsVideoCarousel from '../../components/DoctorsVideoCarousel.astro';
import OurPartnerHospitals from '../../components/OurPartnerHospitals.astro';
import TreatmentCostComparison from '../../components/TreatmentCostComparison.astro';
import CostEstimateCta from '../../components/CostEstimateCta.astro';
import SupportServices from '../../components/SupportServices.astro';
import Layout from '../../layouts/Layout.astro';
import { fr } from '../../i18n/fr';
import { frAbout } from '../../i18n/fr-pages';
import { frPartnerHospitalsHome, frSupportServices, frTravelProcess, frCostComparison, frWhyChooseUs } from '../../i18n/fr-home';
import { doctors as defaultDoctors } from '../../data/doctors';
import { translateDoctors } from '../../i18n/doctorsTranslate';
import { frDoctorsTr } from '../../i18n/fr-doctors';
import { hospitals } from '../../data/hospitals';
import { translateHospitals } from '../../i18n/fr-hospitals';

const frenchHospitals = translateHospitals(hospitals.slice(0, 4));

const videoEntries = translateDoctors(defaultDoctors, frDoctorsTr)
	.flatMap((doctor) => doctorVideoUrls(doctor).map((videoUrl) => ({ doctor, videoUrl })));
---

<Layout
	title="Tourisme médical de confiance en Inde | AlisPro MediTours"
	description="AlisPro MediTours aide les patients internationaux à accéder à des soins de santé fiables en Inde grâce à une assistance médicale experte, une coordination hospitalière, une planification des traitements et un accompagnement personnalisé."
	locale="fr"
	alternates={[
		{ locale: 'en', href: '/' },
		{ locale: 'fr', href: '/fr/' },
		{ locale: 'ru', href: '/ru/' },
		{ locale: 'bn', href: '/bn/' },
		{ locale: 'ro', href: '/ro/' },
		{ locale: 'es', href: '/es/' },
		{ locale: 'pt', href: '/pt/' },
		{ locale: 'vi', href: '/vi/' },
		{ locale: 'ar', href: '/ar/' },
	]}
>
	<HeroSection
		trust={fr.hero.trust}
		enquiry={fr.hero.enquiry}
	/>
	<Achievements
		badge="Notre impact"
		title="Des chiffres qui"
		highlight="parlent d'eux-mêmes"
		subtitle={`Plus de 5 ans de coordination de soins de classe mondiale, mesurés par les patients que nous avons aidés.`}
		labels={{
			countriesTouched: 'Pays touchés',
			livesImpacted: 'Vies impactées',
			yearsOfExcellence: "Années d'excellence",
			accreditedHospitals: 'Hôpitaux accrédités',
		}}
	/>
	<WhyChooseUs
		badge={frWhyChooseUs.badge}
		title={frWhyChooseUs.title}
		highlight={frWhyChooseUs.highlight}
		subtitle={frWhyChooseUs.subtitle}
		reasons={frWhyChooseUs.reasons}
	/>
	<DoctorsVideoCarousel
		badge="Rencontrez nos spécialistes"
		title="Écoutez nos"
		highlight="médecins"
		subtitle={`De courtes présentations vidéo des spécialistes qui coordonnent vos soins.`}
		experienceLabel="Ans d'exp."
		viewProfileLabel="Voir le profil"
		previousLabel="Médecins précédents"
		nextLabel="Médecins suivants"
		closeLabel="Fermer la vidéo"
		entries={videoEntries}
	/>
	<OurPartnerHospitals
		badge={frPartnerHospitalsHome.badge}
		title={frPartnerHospitalsHome.title}
		highlight={frPartnerHospitalsHome.highlight}
		subtitle={frPartnerHospitalsHome.subtitle}
		hospitals={frenchHospitals}
		basePath="/fr"
	/>
	<TreatmentCostComparison
		basePath="/fr"
		title={frCostComparison.title}
		subtitle={frCostComparison.subtitle}
		discoverText={frCostComparison.discoverText}
		startingLabel={frCostComparison.startingLabel}
		getQuoteLabel={frCostComparison.getQuoteLabel}
		chatLabel={frCostComparison.chatLabel}
		treatmentNames={frCostComparison.treatmentNames}
		doctors={translateDoctors(defaultDoctors, frDoctorsTr)}
	/>
	<SupportServices
		badge={frSupportServices.badge}
		title={frSupportServices.titleLead}
		highlight={frSupportServices.titleHighlight}
		subtitle={frSupportServices.subtitle}
		services={frSupportServices.services}
	/>
	<TravelProcess
		badge={frTravelProcess.badge}
		title={frTravelProcess.titleLead}
		highlight={frTravelProcess.titleHighlight}
		subtitle={frTravelProcess.subtitle}
		steps={frTravelProcess.steps}
	/>
	<CostEstimateCta
		title="Vous voulez une estimation précise de votre traitement ?"
		text="Téléversez vos rapports médicaux et recevez un plan de traitement personnalisé avec une estimation de coût transparente de nos spécialistes sous 24 heures."
		primaryLabel="Obtenir un devis gratuit"
		primaryHref="/fr/contact"
		secondaryLabel="Téléverser des rapports médicaux"
		secondaryHref="/fr/contact#enquiry-form"
	/>
</Layout>
