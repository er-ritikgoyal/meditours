---
import Layout from '../../layouts/Layout.astro';
import OurDoctors from '../../components/OurDoctors.astro';
import DoctorsVideoCarousel from '../../components/DoctorsVideoCarousel.astro';
import CostEstimateCta from '../../components/CostEstimateCta.astro';
import { bnDoctorsPage } from '../../i18n/bn-pages';
import { translateDoctors } from '../../i18n/doctorsTranslate';
import { bnDoctorsTr } from '../../i18n/bn-doctors';
import { doctors } from '../../data/doctors';

const { listing, card, detail } = bnDoctorsPage;
const videoEntries = doctors
	.filter((doctor) => doctor.videoUrl)
	.map((doctor) => ({ doctor, videoUrl: doctor.videoUrl }));
---

<Layout
	title="আমাদের ডাক্তারগণ | ভারতে বোর্ড-সার্টিফাইড বিশেষজ্ঞ | AlisPro MediTours"
	description="AlisPro MediTours নেটওয়ার্কের বোর্ড-সার্টিফাইড বিশেষজ্ঞদের সাথে পরিচিত হন — কার্ডিয়াক, অর্থোপেডিক, অনকোলজি, কসমেটিক, নিউরোলজি এবং ফার্টিলিটি বিশেষজ্ঞরা, ভারত জুড়ে স্বীকৃত হাসপাতালে যুক্ত।"
	locale="bn"
	alternates={[
		{ locale: 'en', href: '/doctors' },
		{ locale: 'fr', href: '/fr/doctors' },
		{ locale: 'ru', href: '/ru/doctors' },
		{ locale: 'bn', href: '/bn/doctors' },
		{ locale: 'ro', href: '/ro/doctors' },
		{ locale: 'es', href: '/es/doctors' },
		{ locale: 'pt', href: '/pt/doctors' },
		{ locale: 'vi', href: '/vi/doctors' },
		{ locale: 'ar', href: '/ar/doctors' },
	]}
>
	<OurDoctors
		basePath="/bn"
		doctors={translateDoctors(doctors, bnDoctorsTr)}
		badge={listing.gridBadge}
		title={listing.gridTitle}
		highlight={listing.gridHighlight}
		subtitle={listing.gridSubtitle}
		yearsExpLabel={card.yearsExpLabel}
		reviewsLabel={card.reviewsLabel}
		contactLabel={card.contactLabel}
		verifiedLabel={card.verifiedLabel}
	/>

	<DoctorsVideoCarousel entries={videoEntries} />

	<CostEstimateCta
		title="আপনার চিকিৎসার সঠিক খরচ জানতে চান?"
		text="আপনার মেডিকেল রিপোর্ট আপলোড করুন এবং ২৪ ঘণ্টার মধ্যে আমাদের বিশেষজ্ঞদের কাছ থেকে স্বচ্ছ খরচসহ ব্যক্তিগতকৃত চিকিৎসা পরিকল্পনা পান।"
		primaryLabel="বিনামূল্যে কোট নিন"
		primaryHref="/bn/contact"
		secondaryLabel="মেডিকেল রিপোর্ট আপলোড করুন"
		secondaryHref="/bn/contact#enquiry-form"
	/>
</Layout>
