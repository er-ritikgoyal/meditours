---
import { doctorVideoUrls } from '../../data/doctors';
import HeroSection from '../../components/HeroSection.astro';
import Achievements from '../../components/Achievements.astro';
import TravelProcess from '../../components/TravelProcess.astro';
import WhyChooseUs from '../../components/WhyChooseUs.astro';
import DoctorsVideoCarousel from '../../components/DoctorsVideoCarousel.astro';
import OurPartnerHospitals from '../../components/OurPartnerHospitals.astro';
import TreatmentCostComparison from '../../components/TreatmentCostComparison.astro';
import CostEstimateCta from '../../components/CostEstimateCta.astro';
import SupportServices from '../../components/SupportServices.astro';
import Layout from '../../layouts/Layout.astro';
import { bn } from '../../i18n/bn';
import { bnAbout } from '../../i18n/bn-pages';
import { bnPartnerHospitalsHome, bnSupportServices, bnTravelProcess, bnCostComparison, bnWhyChooseUs } from '../../i18n/bn-home';
import { doctors as defaultDoctors } from '../../data/doctors';
import { translateDoctors } from '../../i18n/doctorsTranslate';
import { bnDoctorsTr } from '../../i18n/bn-doctors';
import { hospitals } from '../../data/hospitals';
import { translateHospitals } from '../../i18n/bn-hospitals';

const bengaliHospitals = translateHospitals(hospitals.slice(0, 4));

const videoEntries = translateDoctors(defaultDoctors, bnDoctorsTr)
	.flatMap((doctor) => doctorVideoUrls(doctor).map((videoUrl) => ({ doctor, videoUrl })));
---

<Layout
	title="ভারতে বিশ্বস্ত মেডিকেল ট্যুরিজম | AlisPro MediTours"
	description="AlisPro MediTours আন্তর্জাতিক রোগীদের ভারতে নির্ভরযোগ্য চিকিৎসা পেতে সাহায্য করে: হাসপাতাল সমন্বয়, চিকিৎসা পরিকল্পনা ও ভ্রমণ সহায়তা।"
	locale="bn"
	alternates={[
		{ locale: 'en', href: '/' },
		{ locale: 'fr', href: '/fr/' },
		{ locale: 'ru', href: '/ru/' },
		{ locale: 'bn', href: '/bn/' },
		{ locale: 'ro', href: '/ro/' },
		{ locale: 'es', href: '/es/' },
		{ locale: 'pt', href: '/pt/' },
		{ locale: 'vi', href: '/vi/' },
		{ locale: 'ar', href: '/ar/' },
	]}
>
	<HeroSection
		trust={bn.hero.trust}
		enquiry={bn.hero.enquiry}
	/>
	<Achievements
		badge="আমাদের প্রভাব"
		title="সংখ্যা যা"
		highlight="নিজেই কথা বলে"
		subtitle={`৫ বছরেরও বেশি সময় ধরে বিশ্বমানের চিকিৎসা সমন্বয়, আমরা যত রোগীকে সাহায্য করেছি তা দিয়ে পরিমাপ করা হয়েছে।`}
		labels={{
			countriesTouched: 'দেশ পৌঁছেছে',
			livesImpacted: 'জীবন প্রভাবিত',
			yearsOfExcellence: 'বছরের উৎকর্ষতা',
			accreditedHospitals: 'স্বীকৃত হাসপাতাল',
		}}
	/>
	<WhyChooseUs
		badge={bnWhyChooseUs.badge}
		title={bnWhyChooseUs.title}
		highlight={bnWhyChooseUs.highlight}
		subtitle={bnWhyChooseUs.subtitle}
		reasons={bnWhyChooseUs.reasons}
	/>
	<DoctorsVideoCarousel
		badge="আমাদের বিশেষজ্ঞদের সাথে পরিচিত হন"
		title="শুনুন আমাদের"
		highlight="ডাক্তারদের কাছ থেকে"
		subtitle={`আপনার যত্ন সমন্বয়কারী বিশেষজ্ঞদের সংক্ষিপ্ত ভিডিও পরিচিতি।`}
		experienceLabel="বছরের অভিজ্ঞতা"
		viewProfileLabel="প্রোফাইল দেখুন"
		previousLabel="আগের ডাক্তার"
		nextLabel="পরবর্তী ডাক্তার"
		closeLabel="ভিডিও বন্ধ করুন"
		entries={videoEntries}
	/>
	<OurPartnerHospitals
		badge={bnPartnerHospitalsHome.badge}
		title={bnPartnerHospitalsHome.title}
		highlight={bnPartnerHospitalsHome.highlight}
		subtitle={bnPartnerHospitalsHome.subtitle}
		hospitals={bengaliHospitals}
		basePath="/bn"
	/>
	<TreatmentCostComparison
		basePath="/bn"
		title={bnCostComparison.title}
		subtitle={bnCostComparison.subtitle}
		discoverText={bnCostComparison.discoverText}
		startingLabel={bnCostComparison.startingLabel}
		getQuoteLabel={bnCostComparison.getQuoteLabel}
		chatLabel={bnCostComparison.chatLabel}
		treatmentNames={bnCostComparison.treatmentNames}
		doctors={translateDoctors(defaultDoctors, bnDoctorsTr)}
	/>
	<SupportServices
		badge={bnSupportServices.badge}
		title={bnSupportServices.titleLead}
		highlight={bnSupportServices.titleHighlight}
		subtitle={bnSupportServices.subtitle}
		services={bnSupportServices.services}
	/>
	<TravelProcess
		badge={bnTravelProcess.badge}
		title={bnTravelProcess.titleLead}
		highlight={bnTravelProcess.titleHighlight}
		subtitle={bnTravelProcess.subtitle}
		steps={bnTravelProcess.steps}
	/>
	<CostEstimateCta
		title="আপনার চিকিৎসার সঠিক প্রাক্কলন চান?"
		text="আপনার মেডিকেল রিপোর্ট আপলোড করুন এবং ২৪ ঘণ্টার মধ্যে আমাদের বিশেষজ্ঞদের কাছ থেকে স্বচ্ছ খরচের প্রাক্কলনসহ একটি ব্যক্তিগতকৃত চিকিৎসা পরিকল্পনা পান।"
		primaryLabel="বিনামূল্যে পরামর্শ নিন"
		primaryHref="/bn/contact"
		secondaryLabel="মেডিকেল রিপোর্ট আপলোড করুন"
		secondaryHref="/bn/contact#enquiry-form"
	/>
</Layout>
