---
import { doctorVideoUrls } from '../data/doctors';
import HeroSection from '../components/HeroSection.astro';
import TravelProcess from '../components/TravelProcess.astro';
import OurDoctors from '../components/OurDoctors.astro';
import OurPartnerHospitals from '../components/OurPartnerHospitals.astro';
import { hospitals } from '../data/hospitals';
import TreatmentCostComparison from '../components/TreatmentCostComparison.astro';
import CostEstimateCta from '../components/CostEstimateCta.astro';
import SupportServices from '../components/SupportServices.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import Layout from '../layouts/Layout.astro';
import DoctorsVideoCarousel from '../components/DoctorsVideoCarousel.astro';
import Achievements from '../components/Achievements.astro';
import { doctors } from '../data/doctors';


const videoEntries = doctors
	.flatMap((doctor) => doctorVideoUrls(doctor).map((videoUrl) => ({ doctor, videoUrl })));
---

<Layout
	alternates={[
		{ locale: 'en', href: '/' },
		{ locale: 'fr', href: '/fr/' },
		{ locale: 'ru', href: '/ru/' },
		{ locale: 'bn', href: '/bn/' },
		{ locale: 'ro', href: '/ro/' },
		{ locale: 'es', href: '/es/' },
		{ locale: 'pt', href: '/pt/' },
		{ locale: 'vi', href: '/vi/' },
		{ locale: 'ar', href: '/ar/' },
	]}
>
	<HeroSection />
	<Achievements />
	<WhyChooseUs />
	<!-- <OurDoctors badge="Our Medical Team" title="Meet Our" highlight="Specialists" /> -->

	<DoctorsVideoCarousel entries={videoEntries} />
	<!-- <OurDoctors /> -->
	<OurPartnerHospitals hospitals={hospitals.slice(0, 4)} />
	<TreatmentCostComparison />
	<SupportServices />
	<TravelProcess />
	<CostEstimateCta />
</Layout>

<style>
	:global(.process + .cost-cta) {
		margin-top: 0;
	}
</style>
