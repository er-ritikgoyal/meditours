---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FlightServices from '../../components/FlightServices.astro';
import FlightPerks from '../../components/FlightPerks.astro';
import PopularRoutes from '../../components/PopularRoutes.astro';
import CostEstimateCta from '../../components/CostEstimateCta.astro';
import iconAirline from 'bootstrap-icons/icons/airplane-fill.svg?raw';
import iconPeople from 'bootstrap-icons/icons/people-fill.svg?raw';
import iconHeadset from 'bootstrap-icons/icons/headset.svg?raw';
import iconArrowRight from 'bootstrap-icons/icons/arrow-right.svg?raw';
import { arFlights } from '../../i18n/ar-tourism';

const statIcons = [iconAirline, iconPeople, iconHeadset];
const stats = arFlights.stats.map((stat, i) => ({ ...stat, icon: statIcons[i] }));
---

<Layout
	title="حجز رحلات علاجية ودعم السفر في الهند | AlisPro MediTours"
	description="احجز رحلاتك الجوية لعلاجك في الهند مع AlisPro MediTours. احصل على مساعدة الحجز والمرافقة الطبية ورحلات النقالة وتذاكر المرافقين ومساعدة التأشيرة والتوصيل من المطار إلى المستشفى."
	locale="ar"
	alternates={[
		{ locale: 'en', href: '/flights' },
		{ locale: 'fr', href: '/fr/flights' },
		{ locale: 'ru', href: '/ru/flights' },
		{ locale: 'bn', href: '/bn/flights' },
		{ locale: 'ro', href: '/ro/flights' },
		{ locale: 'es', href: '/es/flights' },
		{ locale: 'pt', href: '/pt/flights' },
		{ locale: 'vi', href: '/vi/flights' },
		{ locale: 'ar', href: '/ar/flights' },
	]}
>
	<PageHeader
		badge={arFlights.pageHeader.badge}
		title={arFlights.pageHeader.title}
		highlight={arFlights.pageHeader.highlight}
		subtitle={arFlights.pageHeader.subtitle}
		breadcrumbs={[{ label: 'الرحلات الجوية' }]}
		homeHref="/ar/"
		homeLabel="الرئيسية"
	/>

	<section class="flight-stats">
		<div class="flight-stats__inner">
			{
				stats.map((stat) => (
					<div class="flight-stat">
						<span class="flight-stat__icon" set:html={stat.icon} aria-hidden="true" />
						<strong data-countup data-value={stat.value} data-suffix={stat.suffix} data-decimals={stat.decimals ?? 0}>
							0{stat.suffix}
						</strong>
						<span class="flight-stat__label">{stat.label}</span>
					</div>
				))
			}
		</div>
	</section>

	<FlightServices
		badge={arFlights.services.badge}
		titleLead={arFlights.services.titleLead}
		titleHighlight={arFlights.services.titleHighlight}
		subtitle={arFlights.services.subtitle}
		services={arFlights.services.items}
		ctaLabel={arFlights.services.ctaLabel}
	/>
	<FlightPerks
		badge={arFlights.perks.badge}
		titleLead={arFlights.perks.titleLead}
		titleHighlight={arFlights.perks.titleHighlight}
		subtitle={arFlights.perks.subtitle}
		labels={arFlights.perks.labels}
	/>
	<PopularRoutes
		badge={arFlights.routes.badge}
		titleLead={arFlights.routes.titleLead}
		titleHighlight={arFlights.routes.titleHighlight}
		subtitle={arFlights.routes.subtitle}
		routes={arFlights.routes.items}
		fromLabel={arFlights.routes.fromLabel}
		ctaLabel={arFlights.routes.ctaLabel}
	/>

	<section class="flight-cta">
		<div class="flight-cta__inner">
			<h2>{arFlights.ctaHeading}</h2>
			<p>{arFlights.ctaBody}</p>
			<a class="flight-cta__btn" href="/ar/contact">
				تحدث مع منسّق
				<span set:html={iconArrowRight} aria-hidden="true" />
			</a>
		</div>
	</section>
	<CostEstimateCta
		title="هل تريد تقديرًا دقيقًا لتكلفة علاجك؟"
		text="ارفع تقاريرك الطبية واحصل على خطة علاج شخصية مع تقدير تكلفة شفاف من اختصاصيينا، خلال 24 ساعة."
		primaryLabel="استشارة مجانية"
		primaryHref="/ar/contact"
		secondaryLabel="ارفع تقاريرك الطبية"
		secondaryHref="/ar/contact#enquiry-form"
	/>
</Layout>

<script>
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const countEls = document.querySelectorAll<HTMLElement>('[data-countup]');

	const runCountUp = (el: HTMLElement) => {
		const target = parseFloat(el.dataset.value ?? '0');
		const suffix = el.dataset.suffix ?? '';
		const decimals = parseInt(el.dataset.decimals ?? '0', 10);

		if (prefersReducedMotion) {
			el.textContent = `${target.toFixed(decimals)}${suffix}`;
			return;
		}

		const duration = 1200;
		const start = performance.now();

		const tick = (now: number) => {
			const progress = Math.min((now - start) / duration, 1);
			const eased = 1 - (1 - progress) * (1 - progress);
			const current = target * eased;
			el.textContent = `${current.toFixed(decimals)}${suffix}`;
			if (progress < 1) requestAnimationFrame(tick);
		};
		requestAnimationFrame(tick);
	};

	const observer = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (entry.isIntersecting) {
					runCountUp(entry.target as HTMLElement);
					observer.unobserve(entry.target);
				}
			});
		},
		{ threshold: 0.5 }
	);
	countEls.forEach((el) => observer.observe(el));
</script>

<style>
	.flight-stats {
		background: var(--gradient-premium);
		padding: 40px 24px;
		font-family: var(--font-body);
	}

	.flight-stats__inner {
		max-width: 900px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.flight-stat {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 6px;
	}

	.flight-stat__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 20px;
		height: 20px;
		color: var(--color-gold);
		margin-bottom: 4px;
	}

	.flight-stat__icon :global(svg) {
		width: 100%;
		height: 100%;
	}

	.flight-stat strong {
		font-family: var(--font-heading);
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		font-weight: 700;
		color: #ffffff;
	}

	.flight-stat__label {
		font-size: 12.5px;
		color: rgba(255, 255, 255, 0.75);
	}

	.flight-cta {
		background: var(--color-bg-alt);
		padding: 72px 24px;
		text-align: center;
		font-family: var(--font-body);
	}

	.flight-cta__inner {
		max-width: 600px;
		margin: 0 auto;
	}

	.flight-cta h2 {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 2.6vw, 2rem);
		font-weight: 700;
		color: var(--color-text-primary);
		margin: 0;
	}

	.flight-cta p {
		margin: 14px 0 0;
		font-size: 15px;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.flight-cta__btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 28px;
		padding: 13px 28px;
		border-radius: var(--radius-md);
		background: var(--btn-primary-bg);
		color: var(--btn-primary-text);
		font-size: 14.5px;
		font-weight: 600;
		text-decoration: none;
		transition:
			background 0.15s ease,
			transform 0.15s ease;
	}

	.flight-cta__btn:hover {
		background: var(--btn-primary-hover);
		transform: translateY(-2px);
	}

	.flight-cta__btn :global(svg) {
		width: 18px;
		height: 18px;
	}

	@media screen and (max-width: 640px) {
		.flight-stats__inner {
			gap: 16px;
		}

		.flight-stat strong {
			font-size: 1.4rem;
		}
	}
</style>
