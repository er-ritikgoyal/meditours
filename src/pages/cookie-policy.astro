---
import LegalArticle from '../components/LegalArticle.astro';
import { Content } from '../legal/cookie-policy.md';
---

<LegalArticle
	title="Cookie Policy"
	description="What cookies alispromeditours.com uses, why, and how to manage your preferences."
	effectiveDate="20 October 2026"
>
	<button type="button" class="cookie-btn" id="open-cookie-settings">Manage Cookie Preferences</button>
	<Content />
</LegalArticle>

<script>
	document.getElementById('open-cookie-settings')?.addEventListener('click', () => {
		document.dispatchEvent(new CustomEvent('cc:open'));
	});
</script>

<style>
	.cookie-btn {
		font-family: var(--font-body);
		font-size: 14px;
		font-weight: 700;
		color: var(--btn-primary-text);
		background: var(--btn-primary-bg);
		border: none;
		border-radius: 999px;
		padding: 12px 24px;
		cursor: pointer;
		margin-bottom: 24px;
	}

	.cookie-btn:hover {
		background: var(--btn-primary-hover);
	}
</style>
