---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Rich from '../../components/Rich.astro';
import { stripTags } from '../../utils/richText';
import EnquiryCard from '../../components/EnquiryCard.astro';
import CmsMark from '../../components/CmsMark.astro';
import RecommendationLayout from '../../components/RecommendationLayout.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import CostEstimateCta from '../../components/CostEstimateCta.astro';
import OurPartnerHospitals from '../../components/OurPartnerHospitals.astro';
import iconAward from 'bootstrap-icons/icons/award-fill.svg?raw';
import iconBed from 'bootstrap-icons/icons/building-fill-check.svg?raw';
import iconGeo from 'bootstrap-icons/icons/geo-alt-fill.svg?raw';
import iconDownload from 'bootstrap-icons/icons/file-earmark-arrow-down.svg?raw';
import iconCheck from 'bootstrap-icons/icons/check-circle-fill.svg?raw';
import iconCalendar from 'bootstrap-icons/icons/calendar-check-fill.svg?raw';
import iconCert from 'bootstrap-icons/icons/patch-check-fill.svg?raw';
import iconHospital from 'bootstrap-icons/icons/hospital-fill.svg?raw';
import iconPersonBadge from 'bootstrap-icons/icons/person-badge-fill.svg?raw';
import { hospitals, type HospitalData } from '../../data/hospitals';
import { doctors } from '../../data/doctors';
import { destinations } from '../../data/destinations';
import { successStories } from '../../data/successStories';
import 'flag-icons/css/flag-icons.min.css';
import { hospitalDetails } from '../../data/hospitalDetails';
import { detailLabels } from '../../i18n/hospitalNames';
import { getOverview } from '../../i18n/overviews';
import { getHospitalAbout, ABOUT_KEYS } from '../../i18n/about';

export function getStaticPaths() {
	return hospitals.map((hospital) => ({
		params: { slug: hospital.slug },
		props: { hospital },
	}));
}

const { hospital } = Astro.props as { hospital: HospitalData };

const destination = destinations.find((d) => d.slug === hospital.citySlug);

// Doctors whose profile lists this hospital — best-effort text match, since
// a doctor's `hospital` field is free text, not a foreign key to a slug.
const cityToken = hospital.city.split(/[,/]/)[0].trim();
const affiliatedDoctors = doctors.filter((d) => d.hospital.includes(hospital.name) && d.hospital.includes(cityToken));
const hospitalStories = successStories.filter((s) => s.hospitalSlug === hospital.slug);

const relatedHospitals = hospitals.filter((h) => h.citySlug === hospital.citySlug && h.slug !== hospital.slug).slice(0, 3);

const cityLabel = hospital.city.split(/[,/]/)[0].trim();

const details = hospitalDetails[hospital.slug];
const labels = detailLabels['en'];
const overview = getOverview(hospital.slug, 'en', hospital.name, hospital.name);
const aboutSections = getHospitalAbout(hospital.slug, 'en', hospital.name, hospital.name, hospital.citySlug, hospital.city);
---

<Layout
	title={`${hospital.name}, ${hospital.city} | Hospital Profile | AlisPro MediTours`}
	description={`${hospital.name} in ${hospital.city}, ${hospital.country} — ${hospital.accreditation}. ${stripTags(hospital.about)}`.slice(0, 155)}
	alternates={[
			{ locale: 'en', href: `/hospitals/${hospital.slug}` },
			{ locale: 'fr', href: `/fr/hospitals/${hospital.slug}` },
			{ locale: 'ru', href: `/ru/hospitals/${hospital.slug}` },
			{ locale: 'bn', href: `/bn/hospitals/${hospital.slug}` },
			{ locale: 'ro', href: `/ro/hospitals/${hospital.slug}` },
			{ locale: 'es', href: `/es/hospitals/${hospital.slug}` },
			{ locale: 'pt', href: `/pt/hospitals/${hospital.slug}` },
			{ locale: 'vi', href: `/vi/hospitals/${hospital.slug}` },
			{ locale: 'ar', href: `/ar/hospitals/${hospital.slug}` },
	]}
>
	<PageHeader
		badge={hospital.accreditation}
		title={hospital.name}
		subtitle={`${hospital.city}, ${hospital.country}`}
		breadcrumbs={[
			{ label: 'Destinations', href: '/destinations' },
			...(destination ? [{ label: destination.city, href: `/destinations/${destination.slug}` }] : []),
			{ label: hospital.name },
		]}
	/>

	<RecommendationLayout kind="hospital" slug={Astro.params.slug} locale="en">
		<section class="hospital-detail">
			<div class="hospital-detail__inner">
				<div class="hospital-detail__main">
					<CmsMark kind="s" k="image">
					{
						hospital.image && (
							<div class="hospital-detail__banner">
								<CmsMark kind="img" k="image"><Image src={hospital.image} alt={hospital.name} width={960} height={420} /></CmsMark>
								
							</div>
							<div class="mdiv"> <a class="quotes__btn quotes__btn--chat" href="https://wa.me/919821701155?text=Hello%2C%20I%20am%20interested%20in%20the%20services%20listed%20on%20your%20website" target="_blank" rel="noopener noreferrer" data-astro-cid-h4ecvy3w=""><span aria-hidden="true" data-astro-cid-h4ecvy3w=""><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-whatsapp" viewBox="0 0 16 16">
  <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"></path>
</svg></span>Chat</a>
<a class="quotes__btn quotes__btn--quote" href="/contact#enquiry-form" data-astro-cid-h4ecvy3w="">Get Quote</a></div>

						)
					}
					</CmsMark>

					<div class="hospital-detail__section">
						<h2>About {hospital.name}</h2>
						<p><CmsMark k="about"><Rich text={hospital.about} /></CmsMark></p>
						<CmsMark kind="s" k="about-long">
						{
							aboutSections ? (
								<div class="hospital-detail__long">
									{/* Hospital-specific parts (editable in /editor/): always marked, even when empty, so a live edit can add one. */}
									{ABOUT_KEYS.map((key) => {
										const s = aboutSections.find((x) => x.key === key);
										return (
											<CmsMark kind="s" k={`about-${key}`}>
												{s && (
													<>
														<h3>{s.title}</h3>
														<CmsMark kind="l" k={`about-${key}`}>
															{s.paragraphs.map((p) => (
																<CmsMark kind="i" k={`about-${key}`}><p><CmsMark kind="v" k="_"><Rich text={p} /></CmsMark></p></CmsMark>
															))}
														</CmsMark>
													</>
												)}
											</CmsMark>
										);
									})}
									{aboutSections.filter((s) => !s.key).map((s) => (
										<>
											<h3>{s.title}</h3>
											{s.paragraphs.map((p) => (
												<p>{p}</p>
											))}
										</>
									))}
								</div>
							) : (
								<CmsMark kind="s" k="overview">{overview && <p><CmsMark k="overview"><Rich text={overview} /></CmsMark></p>}</CmsMark>
							)
						}
						</CmsMark>
						<CmsMark kind="s" k="videoUrl">{hospital.videoUrl && <VideoEmbed url={hospital.videoUrl} title={hospital.name} />}</CmsMark>
					</div>

					<div class="hospital-detail__section">
						<h2>Specialties &amp; Departments</h2>
						<ul class="hospital-detail__specialties">
							<CmsMark kind="l" k="specialties">
								{hospital.specialties.map((specialty) => (
									<CmsMark kind="i" k="specialties">
										<li>
											<span set:html={iconCheck} aria-hidden="true" />
											<CmsMark kind="v" k="_">{specialty}</CmsMark>
										</li>
									</CmsMark>
								))}
							</CmsMark>
						</ul>
					</div>

					<CmsMark kind="s" k="doctors">
					{
						affiliatedDoctors.length > 0 && (
							<div class="hospital-detail__section">
								<h2>Doctors at {hospital.name}</h2>
								<div class="hospital-detail__doctors">
									<CmsMark kind="l" k="doctors">
										{affiliatedDoctors.map((doc) => (
											<CmsMark kind="i" k="doctors">
												<a class="hospital-doctor-card" href={`/doctors/${doc.slug}`}>
													<span class="hospital-doctor-card__icon" set:html={iconPersonBadge} aria-hidden="true" />
													<span class="hospital-doctor-card__text">
														<strong><CmsMark kind="v" k="name">{doc.name}</CmsMark></strong>
														<span><CmsMark kind="v" k="specialty">{doc.specialty}</CmsMark></span>
													</span>
												</a>
											</CmsMark>
										))}
									</CmsMark>
								</div>
							</div>
						)
					}
					</CmsMark>

					{hospitalStories.length > 0 && (
						<div class="hospital-detail__section">
							<h2>Patient Success Stories</h2>
							<div class="hospital-stories">
								{hospitalStories.map((s) => (
									<a class="hospital-story-card" href={`/success-stories/${s.slug}`}>
										<span class={`fi fi-${s.countryCode}`} aria-hidden="true" />
										<span class="hospital-story-card__text">
											<strong>{s.name}</strong>
											<span>{s.treatment} — {s.country}</span>
										</span>
									</a>
								))}
							</div>
						</div>
					)}
				</div>

				<aside class="hospital-detail__sidebar">
					<div class="hospital-detail__sidebar-sticky">
						<div class="hospital-facts">
							<h3>
								<span set:html={iconHospital} aria-hidden="true" />
								Quick Facts
							</h3>
							<ul>
								<li>
									<span set:html={iconAward} aria-hidden="true" />
									<span>
										<strong>Accreditation</strong>
										<span><CmsMark k="accreditation">{hospital.accreditation}</CmsMark></span>
									</span>
								</li>
								<li>
									<span set:html={iconBed} aria-hidden="true" />
									<span>
										<strong>Scale</strong>
										<span><CmsMark k="beds">{hospital.beds}</CmsMark></span>
									</span>
								</li>
								<li>
									<span set:html={iconGeo} aria-hidden="true" />
									<span>
										<strong>Location</strong>
										<span>
											<CmsMark k="city">{hospital.city}</CmsMark>, <CmsMark k="country">{hospital.country}</CmsMark>
										</span>
									</span>
								</li>
								<CmsMark kind="s" k="established">
								{
									details?.established && (
										<li>
											<span set:html={iconCalendar} aria-hidden="true" />
											<span>
												<strong>{labels.established}</strong>
												<span><CmsMark k="established">{details.established}</CmsMark></span>
											</span>
										</li>
									)
								}
								</CmsMark>
								<CmsMark kind="s" k="address">
								{
									details?.address && (
										<li>
											<span set:html={iconGeo} aria-hidden="true" />
											<span>
												<strong>{labels.address}</strong>
												<span><CmsMark k="address">{details.address}</CmsMark></span>
											</span>
										</li>
									)
								}
								</CmsMark>
								<CmsMark kind="s" k="certs">
								{
									details && details.certs.length > 0 && (
										<li>
											<span set:html={iconCert} aria-hidden="true" />
											<span>
												<strong>{labels.certifications}</strong>
												<span><CmsMark k="certs">{details.certs.join(' · ')}</CmsMark></span>
											</span>
										</li>
									)
								}
								</CmsMark>
							</ul>
						</div>
						<EnquiryCard title="Plan Your Treatment" subtitle={`Send your case to our coordination team for ${hospital.name}`} />
					</div>
				</aside>
			</div>
		</section>
	</RecommendationLayout>

	{
		relatedHospitals.length > 0 && (
			<OurPartnerHospitals
				badge="Nearby"
				title="Other Hospitals in"
				highlight={cityLabel}
				subtitle="Other accredited hospitals in the same city, in case you'd like to compare options."
				hospitals={relatedHospitals}
				viewMoreHref={`/destinations/${hospital.citySlug}`}
			/>
		)
	}

	<CostEstimateCta />
</Layout>

<style>
	.hospital-detail {
		padding: 56px 24px;
		font-family: var(--font-body);
	}

	.hospital-detail__inner {
		max-width: 1100px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 320px;
		gap: 40px;
		align-items: start;
	}

	.hospital-detail__main {
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.hospital-detail__banner {
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
	}

	.hospital-detail__banner :global(img) {
		width: 100%;
		height: auto;
		display: block;
	}

	.hospital-detail__section h2 {
		font-family: var(--font-heading);
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--color-text-primary);
		margin: 0 0 12px;
	}

	.hospital-detail__long h3 {
		font-family: var(--font-heading);
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--color-text-primary);
		margin: 24px 0 8px;
	}

	.hospital-detail__section .hospital-detail__long p {
		margin: 0 0 12px;
	}

	.hospital-detail__section p {
		font-size: 15px;
		line-height: 1.7;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.hospital-detail__specialties {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 10px;
	}

	.hospital-detail__specialties li {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 10px 14px;
		background: var(--color-bg-soft-blue);
		border-radius: var(--radius-md);
		font-size: 14px;
		font-weight: 600;
		color: var(--color-text-primary);
	}

	.hospital-detail__specialties li span:first-child {
		display: flex;
		width: 15px;
		height: 15px;
		flex-shrink: 0;
		color: var(--color-teal-text);
	}

	.hospital-detail__specialties li span:first-child :global(svg) {
		width: 100%;
		height: 100%;
	}

	.hospital-detail__doctors {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 12px;
	}

	.hospital-doctor-card {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 14px;
		border: 1px solid var(--color-border-light);
		border-radius: var(--radius-md);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease;
	}

	.hospital-doctor-card:hover {
		border-color: var(--color-teal);
		box-shadow: var(--shadow-soft);
	}

	.hospital-doctor-card__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		flex-shrink: 0;
		border-radius: 50%;
		background: var(--color-bg-soft-blue);
		color: var(--color-teal-text);
	}

	.hospital-doctor-card__icon :global(svg) {
		width: 15px;
		height: 15px;
	}

	.hospital-doctor-card__text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.hospital-doctor-card__text strong {
		font-size: 13.5px;
		color: var(--color-text-primary);
	}

	.hospital-doctor-card__text span {
		font-size: 12.5px;
		color: var(--color-text-secondary);
	}

	.hospital-stories {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 12px;
	}

	.hospital-story-card {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 12px 14px;
		border: 1px solid var(--color-border-light);
		border-radius: var(--radius-md);
		text-decoration: none;
		transition:
			border-color 0.15s ease,
			box-shadow 0.15s ease;
	}

	.hospital-story-card:hover {
		border-color: var(--color-teal);
		box-shadow: var(--shadow-soft);
	}

	.hospital-story-card .fi {
		flex-shrink: 0;
		width: 26px;
		height: 19px;
		border-radius: 3px;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.08);
	}

	.hospital-story-card__text {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.hospital-story-card__text strong {
		font-size: 13.5px;
		color: var(--color-text-primary);
	}

	.hospital-story-card__text span {
		font-size: 12.5px;
		color: var(--color-text-secondary);
	}

	.hospital-detail__download {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		align-self: flex-start;
		padding: 12px 22px;
		border-radius: 999px;
		background: var(--btn-primary-bg);
		color: var(--btn-primary-text);
		font-size: 14px;
		font-weight: 600;
		text-decoration: none;
		box-shadow: var(--shadow-soft);
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}

	.hospital-detail__download:hover {
		transform: translateY(-1px);
		box-shadow: var(--shadow-card);
	}

	.hospital-detail__download :global(svg) {
		width: 15px;
		height: 15px;
	}

	.hospital-detail__sidebar {
		min-width: 0;
	}

	.hospital-detail__sidebar-sticky {
		position: sticky;
		top: 96px;
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.hospital-facts {
		background: var(--color-bg-white);
		border: 1px solid var(--color-border-light);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-soft);
		padding: 22px;
	}

	.hospital-facts h3 {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: var(--font-heading);
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--color-text-primary);
		margin: 0 0 16px;
	}

	.hospital-facts h3 span:first-child {
		display: flex;
		width: 18px;
		height: 18px;
		color: var(--color-teal-text);
	}

	.hospital-facts h3 span:first-child :global(svg) {
		width: 100%;
		height: 100%;
	}

	.hospital-facts ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.hospital-facts li {
		display: flex;
		align-items: flex-start;
		gap: 10px;
	}

	.hospital-facts li > span:first-child {
		display: flex;
		width: 16px;
		height: 16px;
		margin-top: 2px;
		flex-shrink: 0;
		color: var(--color-teal-text);
	}

	.hospital-facts li > span:first-child :global(svg) {
		width: 100%;
		height: 100%;
	}

	.hospital-facts li > span:last-child {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.hospital-facts li strong {
		font-size: 12.5px;
		font-weight: 700;
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.hospital-facts li > span:last-child > span {
		font-size: 14px;
		font-weight: 600;
		color: var(--color-text-primary);
	}

	@media screen and (max-width: 860px) {
		.hospital-detail {
			padding: 40px 16px;
		}

		.hospital-detail__inner {
			grid-template-columns: minmax(0, 1fr);
		}

		.hospital-detail__specialties {
			grid-template-columns: minmax(0, 1fr);
		}

		.hospital-detail__sidebar-sticky {
			position: static;
		}
	}
	.quotes {
		background: var(--color-bg-white);
		padding: 80px 24px 88px;
		font-family: var(--font-body);
	}

	.quotes__inner {
		max-width: 1320px;
		margin: 0 auto;
	}

	[data-animate] {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}

	[data-animate].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.quotes__header {
		text-align: center;
		max-width: 640px;
		margin: 0 auto 40px;
	}

	.quotes__title {
		font-family: var(--font-heading);
		font-size: clamp(1.8rem, 3.2vw, 2.4rem);
		font-weight: 700;
