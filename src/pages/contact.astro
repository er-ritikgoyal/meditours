---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import iconPhone from 'bootstrap-icons/icons/telephone-fill.svg?raw';
import iconEnvelope from 'bootstrap-icons/icons/envelope-fill.svg?raw';
import iconWhatsapp from 'bootstrap-icons/icons/whatsapp.svg?raw';
import iconGeo from 'bootstrap-icons/icons/geo-alt-fill.svg?raw';
import iconClock from 'bootstrap-icons/icons/clock-fill.svg?raw';
import iconSend from 'bootstrap-icons/icons/send-fill.svg?raw';
import iconPerson from 'bootstrap-icons/icons/person-fill.svg?raw';
import iconChat from 'bootstrap-icons/icons/chat-square-text-fill.svg?raw';
import iconUpload from 'bootstrap-icons/icons/cloud-upload.svg?raw';
import { countries } from '../data/countries';
import { treatments } from '../data/treatments';
const quickOptions = [
	{
		icon: iconPhone,
		title: 'Call Us',
		detail: '+91 98217 01155',
		href: 'tel:+919821701155',
		theme: 'blue',
	},
	{
		icon: iconWhatsapp,
		title: 'WhatsApp Us',
		detail: 'Chat with a coordinator',
		href: 'https://wa.me/919821701155',
		theme: 'teal',
	},
	{
		icon: iconEnvelope,
		title: 'Email Us',
		detail: 'care@alispromeditours.com',
		href: 'mailto:care@alispromeditours.com',
		theme: 'green',
	},
];

const treatmentOptions = [...treatments.map((t) => t.name), 'Other'];
---

<Layout
	title="Contact AlisPro MediTours | Medical Tourism Support in India"
	description="Contact AlisPro MediTours for expert medical tourism assistance in India. Get support with treatment consultations, hospital coordination, travel logistics, and personalised care from our patient coordinators."
	alternates={[
		{ locale: 'en', href: '/contact' },
		{ locale: 'fr', href: '/fr/contact' },
		{ locale: 'ru', href: '/ru/contact' },
		{ locale: 'bn', href: '/bn/contact' },
		{ locale: 'ro', href: '/ro/contact' },
		{ locale: 'es', href: '/es/contact' },
		{ locale: 'pt', href: '/pt/contact' },
		{ locale: 'vi', href: '/vi/contact' },
		{ locale: 'ar', href: '/ar/contact' },
	]}
>
	<PageHeader
		badge="We're Here to Help"
		title="Get in Touch"
		highlight="With Our Team"
		subtitle="Questions about a treatment, cost, or travel logistics? A patient coordinator typically replies within a few hours."
		breadcrumbs={[{ label: 'Contact' }]}
	/>

	<section class="contact">
		<div class="contact__inner">
			<div class="contact__quick">
				{
					quickOptions.map((option) => (
						<a class={`quick-card quick-card--${option.theme}`} href={option.href} target="_blank" rel="noopener noreferrer">
							<span class="quick-card__icon" set:html={option.icon} aria-hidden="true" />
							<span class="quick-card__title">{option.title}</span>
							<span class="quick-card__detail">{option.detail}</span>
						</a>
					))
				}
			</div>

			<div class="contact__grid">
				<div class="contact-form">
					<h2>Send Us a Message</h2>
					<p>Share a few details and our medical team will follow up with next steps.</p>

					<form id="enquiry-form" data-contact-form enctype="multipart/form-data">
						<input type="hidden" name="subject" value="Contact Page Enquiry" />
						<input
							type="text"
							name="website"
							class="contact-form__honeypot"
							tabindex="-1"
							autocomplete="off"
							aria-hidden="true"
						/>

						<div class="contact-form__row">
							<label class="contact-form__field">
								<span>Full Name</span>
								<input type="text" name="name" placeholder="Your full name" autocomplete="name" required />
							</label>
							<label class="contact-form__field">
								<span>Email Address</span>
								<input type="email" name="email" placeholder="you@example.com" autocomplete="email" required />
							</label>
						</div>

						<div class="contact-form__row">
							<label class="contact-form__field">
								<span>Country</span>
								<select name="country" data-country-field>
									<option value="" selected disabled>---Select Country---</option>
									{countries.map((country) => (
										<option value={country.name} data-dial={country.dial}>{country.name}</option>
									))}
								</select>
							</label>
							<label class="contact-form__field">
								<span>Treatment of Interest</span>
								<select name="category" required>
									<option value="" selected disabled>
										Select a treatment
									</option>
									{treatmentOptions.map((option) => (
										<option value={option}>{option}</option>
									))}
								</select>
							</label>
						</div>

						<label class="contact-form__field">
							<span>Phone / WhatsApp</span>
							<div class="contact-form__phone-group">
								<input
									type="text"
									name="phoneCode"
									class="contact-form__phone-code"
									value="+91"
									placeholder="+91"
									inputmode="tel"
									data-phone-code-field
								/>
								<input
									type="tel"
									name="phone"
									placeholder="555 123 4567"
									autocomplete="tel"
									required
									data-phone-field
								/>
							</div>
						</label>

						<label class="contact-form__field">
							<span>Message</span>
							<textarea
								name="message"
								rows="5"
								placeholder="Tell us about your condition, timeline, or any questions you have..."
								required
							/>
						</label>

						<label class="contact-form__field">
							<span>Medical Reports (optional)</span>
							<span class="contact-form__file" data-file-label>
								<span set:html={iconUpload} aria-hidden="true" />
								<span data-file-name>PDF or JPG, up to 5MB</span>
							</span>
							<input type="file" name="attachment" accept=".pdf,.jpg,.jpeg" data-file-input />
						</label>

						<button type="submit" class="contact-form__submit">
							Send Message
							<span set:html={iconSend} aria-hidden="true" />
						</button>

						<p class="contact-form__success" data-contact-success hidden>
							Thanks for reaching out — a patient coordinator will contact you shortly.
						</p>
						<p class="contact-form__error" data-contact-error hidden />
					</form>
				</div>

				<aside class="contact-info">
					<h2>Contact Information</h2>

					<ul class="contact-info__list">
						<li>
							<span set:html={iconGeo} aria-hidden="true" />
							<div>
								<strong>Office Address</strong>
								<span>238 westend Mall, janakpuri, New Delhi, India</span>
							</div>
						</li>
						<li>
							<span set:html={iconPhone} aria-hidden="true" />
							<div>
								<strong>Phone</strong>
								<a href="tel:+919821701155">+91 98217 01155</a>
							</div>
						</li>
						<li>
							<span set:html={iconEnvelope} aria-hidden="true" />
							<div>
								<strong>Email</strong>
								<a href="mailto:care@alispromeditours.com">care@alispromeditours.com</a>
							</div>
						</li>
						<li>
							<span set:html={iconClock} aria-hidden="true" />
							<div>
								<strong>Support Hours</strong>
								<span>24/7 Patient Support</span>
							</div>
						</li>
						<li>
							<span set:html={iconPerson} aria-hidden="true" />
							<div>
								<strong>Dedicated Coordinator</strong>
								<span>Assigned within 24 hours of your first message</span>
							</div>
						</li>
					</ul>

					<div class="contact-info__note">
						<span set:html={iconChat} aria-hidden="true" />
						<p>Prefer to talk it through first? WhatsApp us and we'll call you back within the hour.</p>
					</div>
				</aside>
			</div>
		</div>
	</section>
</Layout>

<script>
	import { bindEnquiryForm } from '../scripts/enquiryForm';

	const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
	const success = document.querySelector('[data-contact-success]');
	const error = document.querySelector('[data-contact-error]');
	const countrySelect = document.querySelector<HTMLSelectElement>('[data-country-field]');
	const phoneCodeInput = document.querySelector<HTMLInputElement>('[data-phone-code-field]');

	countrySelect?.addEventListener('change', () => {
		const dial = countrySelect.selectedOptions[0]?.dataset.dial ?? '';
		if (dial && phoneCodeInput) {
			phoneCodeInput.value = `+${dial}`;
		}
	});

	bindEnquiryForm(form, {
		successEl: success,
		errorEl: error,
		beforeSubmit: (formEl) => {
			const country = formEl.querySelector<HTMLSelectElement>('[data-country-field]')?.value ?? '';
			const phoneCode = formEl.querySelector<HTMLInputElement>('[data-phone-code-field]')?.value ?? '';
			const phoneInput = formEl.querySelector<HTMLInputElement>('[data-phone-field]');
			const phone = phoneInput?.value ?? '';
			const messageEl = formEl.querySelector<HTMLTextAreaElement>('textarea[name="message"]');

			if (phoneInput && phone && !phone.startsWith('+')) {
				phoneInput.value = `${phoneCode} ${phone}`;
			}

			if (messageEl && country && !messageEl.value.startsWith('Country: ')) {
				messageEl.value = `Country: ${country}\n\n${messageEl.value}`;
			}
		},
	});

	const fileInput = document.querySelector<HTMLInputElement>('[data-file-input]');
	const fileName = document.querySelector('[data-file-name]');

	// The file input lives inside .contact-form__field, so clicking the styled
	// data-file-label span already activates it natively — no manual .click() needed
	// (adding one double-triggers the file picker and clobbers the first selection).
	fileInput?.addEventListener('change', () => {
		if (fileName) {
			fileName.textContent = fileInput.files?.[0]?.name ?? 'PDF or JPG, up to 5MB';
		}
	});
</script>

<style>
	.contact {
		background: var(--color-bg-white);
		padding: 72px 24px 96px;
		font-family: var(--font-body);
	}

	.contact__inner {
		max-width: 1100px;
		margin: 0 auto;
	}

	.contact__quick {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
		margin-bottom: 56px;
	}

	.quick-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 4px;
		padding: 26px 20px;
		background: var(--color-bg-white);
		border: 1px solid var(--color-border-card);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-soft);
		text-decoration: none;
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.quick-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-card);
	}

	.quick-card__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		margin-bottom: 10px;
		color: #ffffff;
	}

	.quick-card__icon :global(svg) {
		width: 22px;
		height: 22px;
	}

	.quick-card--blue .quick-card__icon {
		background: linear-gradient(135deg, var(--color-primary) 0%, #2f6fa8 100%);
	}

	.quick-card--teal .quick-card__icon {
		background: linear-gradient(135deg, #0f766e 0%, var(--color-teal) 100%);
	}

	.quick-card--green .quick-card__icon {
		background: linear-gradient(135deg, #15803d 0%, var(--color-green) 100%);
	}

	.quick-card__title {
		font-family: var(--font-heading);
		font-size: 15px;
		font-weight: 700;
		color: var(--color-text-primary);
	}

	.quick-card__detail {
		font-size: 13px;
		color: var(--color-text-muted);
	}

	.contact__grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: 40px;
		align-items: start;
	}

	.contact-form,
	.contact-info {
		background: var(--color-bg-white);
		border: 1px solid var(--color-border-card);
		border-radius: var(--radius-lg);
		padding: 32px;
		box-shadow: var(--shadow-soft);
	}

	.contact-form h2,
	.contact-info h2 {
		font-family: var(--font-heading);
		font-size: 20px;
		font-weight: 700;
		color: var(--color-text-primary);
		margin: 0 0 8px;
	}

	.contact-form > p {
		font-size: 13.5px;
		color: var(--color-text-secondary);
		margin: 0 0 24px;
	}

	.contact-form__row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
	}

	.contact-form__field {
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin-bottom: 18px;
	}

	.contact-form__field span {
		font-size: 12.5px;
		font-weight: 600;
		color: var(--color-text-primary);
	}

	.contact-form__field input,
	.contact-form__field select,
	.contact-form__field textarea {
		padding: 11px 14px;
		border-radius: var(--radius-md);
		border: 1px solid var(--color-border-light);
		background: var(--color-bg-soft-blue);
		font-family: var(--font-body);
		font-size: 14px;
		color: var(--color-text-primary);
		resize: vertical;
	}

	.contact-form__field input::placeholder,
	.contact-form__field textarea::placeholder {
		color: var(--color-text-light);
	}

	.contact-form__field input:focus,
	.contact-form__field select:focus,
	.contact-form__field textarea:focus {
		outline: none;
		border-color: var(--color-teal);
	}

	.contact-form__phone-group {
		display: grid;
		grid-template-columns: 84px 1fr;
		gap: 10px;
	}

	.contact-form__phone-code {
		text-align: center;
	}

	.contact-form__submit {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin-top: 6px;
		padding: 13px 28px;
		border: none;
		border-radius: var(--radius-md);
		background: var(--btn-primary-bg);
		color: var(--btn-primary-text);
		font-size: 14.5px;
		font-weight: 600;
		cursor: pointer;
		transition: background 0.15s ease;
	}

	.contact-form__submit:hover {
		background: var(--btn-primary-hover);
	}

	.contact-form__submit :global(svg) {
		width: 18px;
		height: 18px;
	}

	.contact-form__success {
		margin: 14px 0 0;
		padding: 12px 16px;
		border-radius: var(--radius-md);
		background: rgba(34, 197, 94, 0.12);
		color: #15803d;
		font-size: 13.5px;
		font-weight: 600;
	}

	.contact-form__error {
		margin: 14px 0 0;
		padding: 12px 16px;
		border-radius: var(--radius-md);
		background: rgba(239, 68, 68, 0.1);
		color: var(--color-danger);
		font-size: 13.5px;
		font-weight: 600;
	}

	.contact-form__honeypot {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		opacity: 0;
		pointer-events: none;
	}

	.contact-form__file {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 11px 14px;
		border-radius: var(--radius-md);
		border: 1px dashed var(--color-border-light);
		background: var(--color-bg-soft-blue);
		font-size: 13px;
		color: var(--color-text-secondary);
		cursor: pointer;
		transition: border-color 0.15s ease;
	}

	.contact-form__file:hover {
		border-color: var(--color-teal);
	}

	.contact-form__file span:first-child {
		display: flex;
		flex-shrink: 0;
		width: 16px;
		height: 16px;
		color: var(--color-primary);
	}

	.contact-form__file span:first-child :global(svg) {
		width: 100%;
		height: 100%;
	}

	.contact-form__field input[data-file-input] {
		display: none;
	}

	.contact-info__list {
		display: flex;
		flex-direction: column;
		gap: 20px;
		list-style: none;
		margin: 0 0 28px;
		padding: 0;
	}

	.contact-info__list li {
		display: flex;
		align-items: flex-start;
		gap: 12px;
	}

	.contact-info__list li > span {
		display: flex;
		flex-shrink: 0;
		width: 18px;
		height: 18px;
		margin-top: 2px;
		color: var(--color-primary);
	}

	.contact-info__list li > span :global(svg) {
		width: 100%;
		height: 100%;
	}

	.contact-info__list li div {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.contact-info__list li strong {
		font-size: 13.5px;
		font-weight: 700;
		color: var(--color-text-primary);
	}

	.contact-info__list li span:last-child,
	.contact-info__list li a {
		font-size: 13.5px;
		color: var(--color-text-secondary);
		text-decoration: none;
	}

	.contact-info__list li a:hover {
		color: var(--color-primary);
	}

	.contact-info__note {
		display: flex;
		gap: 12px;
		padding: 18px;
		background: var(--color-bg-alt);
		border-radius: var(--radius-md);
	}

	.contact-info__note span {
		display: flex;
		flex-shrink: 0;
		width: 20px;
		height: 20px;
		color: var(--color-teal);
	}

	.contact-info__note span :global(svg) {
		width: 100%;
		height: 100%;
	}

	.contact-info__note p {
		margin: 0;
		font-size: 13px;
		line-height: 1.5;
		color: var(--color-text-secondary);
	}

	@media screen and (max-width: 900px) {
		.contact__quick {
			grid-template-columns: 1fr;
		}

		.contact__grid {
			grid-template-columns: 1fr;
		}
	}

	@media screen and (max-width: 640px) {
		.contact {
			padding: 48px 16px 64px;
		}

		.contact-form,
		.contact-info {
			padding: 24px 20px;
		}

		.contact-form__row {
			grid-template-columns: 1fr;
		}

		.contact-form__phone-group {
			grid-template-columns: 1fr;
		}

		.contact-form__phone-code {
			text-align: start;
		}
	}
</style>
