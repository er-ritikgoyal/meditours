---
import Layout from '../../layouts/Layout.astro';
import OurDoctors from '../../components/OurDoctors.astro';
import DoctorsVideoCarousel from '../../components/DoctorsVideoCarousel.astro';
import CostEstimateCta from '../../components/CostEstimateCta.astro';
import { ptDoctorsPage } from '../../i18n/pt-pages';
import { translateDoctors } from '../../i18n/doctorsTranslate';
import { ptDoctorsTr } from '../../i18n/pt-doctors';
import { doctors } from '../../data/doctors';

const { listing, card, detail } = ptDoctorsPage;
const videoEntries = doctors
	.filter((doctor) => doctor.videoUrl)
	.map((doctor) => ({ doctor, videoUrl: doctor.videoUrl }));
---

<Layout
	title="Nossos médicos | Especialistas certificados na Índia | AlisPro MediTours"
	description="Conheça os especialistas certificados da rede AlisPro MediTours — cardiologia, ortopedia, oncologia, cirurgia estética, neurologia e fertilidade, associados a hospitais acreditados em toda a Índia."
	locale="pt"
	alternates={[
		{ locale: 'en', href: '/doctors' },
		{ locale: 'fr', href: '/fr/doctors' },
		{ locale: 'ru', href: '/ru/doctors' },
		{ locale: 'bn', href: '/bn/doctors' },
		{ locale: 'ro', href: '/ro/doctors' },
		{ locale: 'es', href: '/es/doctors' },
		{ locale: 'pt', href: '/pt/doctors' },
		{ locale: 'vi', href: '/vi/doctors' },
		{ locale: 'ar', href: '/ar/doctors' },
	]}
>
	<OurDoctors
		basePath="/pt"
		doctors={translateDoctors(doctors, ptDoctorsTr)}
		badge={listing.gridBadge}
		title={listing.gridTitle}
		highlight={listing.gridHighlight}
		subtitle={listing.gridSubtitle}
		yearsExpLabel={card.yearsExpLabel}
		reviewsLabel={card.reviewsLabel}
		contactLabel={card.contactLabel}
		verifiedLabel={card.verifiedLabel}
	/>

	<DoctorsVideoCarousel entries={videoEntries} />

	<CostEstimateCta
		title="Quer uma estimativa exata do seu tratamento?"
		text="Envie os seus relatórios médicos e receba um plano de tratamento personalizado com uma estimativa de custo transparente dos nossos especialistas em 24 horas."
		primaryLabel="Obter orçamento gratuito"
		primaryHref="/pt/contact"
		secondaryLabel="Enviar relatórios médicos"
		secondaryHref="/pt/contact#enquiry-form"
	/>
</Layout>
