---
/**
 * Quote / WhatsApp calls to action for treatment pages, in three layouts that
 * fill what used to be empty space:
 *   - "media": wraps the hero photo (slot) and adds a quote bar under it; the
 *     column stretches to the enquiry form's height so no gap is left beside it.
 *   - "steps": a "How it works" card under the short Overview paragraph.
 *   - "card":  a card inside the procedures grid that fills the rest of the
 *     last row (or a full row when the row is already complete).
 * "Get Free Quote" scrolls to the page's enquiry form (falls back to the
 * contact page without JS); "WhatsApp" opens a chat naming the treatment.
 */
import iconWhatsapp from 'bootstrap-icons/icons/whatsapp.svg?raw';
import iconArrow from 'bootstrap-icons/icons/arrow-right-short.svg?raw';
import iconCheck from 'bootstrap-icons/icons/check-circle-fill.svg?raw';
import iconReports from 'bootstrap-icons/icons/file-earmark-medical-fill.svg?raw';
import iconQuote from 'bootstrap-icons/icons/clipboard2-check-fill.svg?raw';
import iconTravel from 'bootstrap-icons/icons/airplane-fill.svg?raw';
import iconChat from 'bootstrap-icons/icons/chat-dots-fill.svg?raw';

export interface Props {
	variant: 'media' | 'steps' | 'card';
	/** Treatment name in the page's language. */
	treatmentName: string;
	locale?: string;
}

const { variant, treatmentName, locale = 'en' } = Astro.props;

interface Strings {
	quote: string;
	whatsapp: string;
	barTitle: (name: string) => string;
	barPoints: [string, string, string];
	stepsTitle: string;
	steps: [[string, string], [string, string], [string, string]];
	cardTitle: string;
	cardText: string;
	waMessage: (name: string) => string;
}

const STRINGS: Record<string, Strings> = {
	en: {
		quote: 'Get Free Quote',
		whatsapp: 'WhatsApp Us',
