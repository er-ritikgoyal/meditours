			['Travel and get treated', 'We help with the visa invitation letter, travel, stay and hospital coordination.'],
		],
		cardTitle: 'Not sure which procedure you need?',
		cardText: 'Share your reports. The treating specialists will advise the right option, and we will send you a cost estimate.',
		waMessage: (n) => `Hello, I would like a quote for ${n}.`,
	},
	fr: {
		quote: 'Devis gratuit',
		whatsapp: 'WhatsApp',
		barTitle: (n) => `Obtenez un devis personnalisé pour ${n}`,
		barPoints: ['Gratuit, sans engagement', 'Réponse sous 24 heures', 'Hôpitaux accrédités'],
		stepsTitle: 'Comment ça marche',
		steps: [
			['Envoyez vos dossiers médicaux', 'Transmettez vos examens et comptes rendus via le formulaire ou sur WhatsApp.'],
			['Recevez un avis et une estimation', 'Nous vous transmettons l’avis des spécialistes et une estimation détaillée, généralement sous 24 heures.'],
			['Voyagez et faites-vous soigner', 'Nous vous aidons pour la lettre d’invitation pour le visa, le voyage, l’hébergement et la coordination avec l’hôpital.'],
		],
		cardTitle: 'Vous ne savez pas quelle intervention choisir ?',
		cardText: 'Envoyez vos examens. Les spécialistes vous conseilleront la bonne option et nous vous enverrons une estimation des coûts.',
		waMessage: (n) => `Bonjour, je souhaite un devis pour ${n}.`,
	},
	es: {
		quote: 'Presupuesto gratis',
		whatsapp: 'WhatsApp',
		barTitle: (n) => `Obtenga un presupuesto personalizado para ${n}`,
		barPoints: ['Gratis y sin compromiso', 'Respuesta en 24 horas', 'Hospitales acreditados'],
		stepsTitle: 'Cómo funciona',
		steps: [
			['Comparta sus informes médicos', 'Envíe sus estudios e informes mediante el formulario o por WhatsApp.'],
