---
/**
 * Cookie consent bar: a compact bottom bar (Accept All / Reject Non-Essential /
 * Customize) until the visitor decides, then the choice is kept in a `cc_consent`
 * cookie: {"v":2,"analytics":bool,"advertising":bool,"decidedAt":ISO}.
 *
 * - Google consent mode v2: GoogleAdsTag.astro sets the defaults from this cookie
 *   before gtag.js loads (everything "denied" until a decision). This component sends
 *   the `consent update` when the visitor decides:
 *     analytics_storage                            <- Analytics choice
 *     ad_storage, ad_user_data, ad_personalization <- Advertising choice
 * - GA4 is configured only when Analytics is granted and a real Measurement ID is set
 *   below. gtag.js itself is loaded once, by GoogleAdsTag.astro.
 * - A cookie from before v2 (one "analytics" switch that also covered ads) keeps its
 *   Analytics answer, treats Advertising as not granted, and asks again.
 * - Locale preference (the language the visitor picked in the navbar) is
 *   treated as strictly necessary — it's not tracking, just remembering an
 *   explicit choice — so it's stored in `site_locale` regardless of the
 *   Analytics decision. Set from Navbar.astro.
 * - Dispatches/listens for a couple of small custom DOM events so other
 *   parts of the site can integrate without importing this component:
 *     - "cc:open"            -> (document) reopens the banner/preferences.
 *     - "enquiry:success"    -> (document, fired by src/scripts/enquiryForm.ts)
 *                               logged as a GA4 "generate_lead" conversion
 *                               event when Analytics consent is granted.
 *
 * TODO before GA4 does anything useful: replace GA_MEASUREMENT_ID below with
 * your real GA4 Measurement ID (GA4 Admin -> Data Streams -> your stream).
 */
import { siteUi } from '../i18n/siteUi';

const GA_MEASUREMENT_ID = 'G-XXXXXXXXXX';

export interface Props {
	locale?: string;
	cookiePolicyHref?: string;
	title?: string;
	description?: string;
	necessaryLabel?: string;
	necessaryDescription?: string;
	analyticsLabel?: string;
	analyticsDescription?: string;
	advertisingLabel?: string;
	advertisingDescription?: string;
	acceptAllLabel?: string;
	rejectLabel?: string;
	customizeLabel?: string;
	savePreferencesLabel?: string;
	policyLinkLabel?: string;
	closeLabel?: string;
}

const {
	locale = 'en',
	cookiePolicyHref = '/cookie-policy',
	title = 'We value your privacy',
	description = 'We use cookies to remember your language preference and to understand how visitors use our site, so we can improve it. You can accept all cookies, reject non-essential ones, or customize your choice.',
	necessaryLabel = 'Necessary',
	necessaryDescription = 'Required for the site to work, such as remembering your selected language. Always on.',
	analyticsLabel = 'Analytics',
	analyticsDescription = 'Helps us understand how visitors use the site so we can improve it. Optional.',
	advertisingLabel,
	advertisingDescription,
	acceptAllLabel = 'Accept All',
	rejectLabel = 'Reject Non-Essential',
	customizeLabel = 'Customize',
	savePreferencesLabel = 'Save Preferences',
	policyLinkLabel = 'Cookie Policy',
	closeLabel = 'Close',
} = Astro.props;

const ui = siteUi(locale).cookies;
// The compact bar shows one short sentence that also names advertising cookies; the older
// `description` prop (language + analytics only) is no longer shown.
const adLabel = advertisingLabel ?? ui.advertisingLabel;
const adDescription = advertisingDescription ?? ui.advertisingDescription;
---

<div class="cc-banner" id="cc-banner" role="dialog" aria-modal="false" aria-labelledby="cc-title" aria-describedby="cc-desc" hidden>
	<div class="cc-banner__inner">
		<div class="cc-banner__main">
			<h2 id="cc-title" class="cc-banner__title">{title}</h2>
			<p class="cc-banner__desc" id="cc-desc">
				{ui.shortDescription}
				{' '}
				<a href={cookiePolicyHref} class="cc-banner__link">{policyLinkLabel}</a>
			</p>

			<div class="cc-banner__categories" id="cc-categories" hidden>
				<div class="cc-category">
					<label class="cc-category__row">
						<span class="cc-category__label">{necessaryLabel}</span>
						<span class="cc-switch cc-switch--disabled">
							<input type="checkbox" checked disabled />
							<span class="cc-switch__track"><span class="cc-switch__thumb"></span></span>
						</span>
					</label>
					<p class="cc-category__desc">{necessaryDescription}</p>
				</div>
				<div class="cc-category">
					<label class="cc-category__row">
						<span class="cc-category__label">{analyticsLabel}</span>
						<span class="cc-switch">
							<input type="checkbox" id="cc-analytics-toggle" />
							<span class="cc-switch__track"><span class="cc-switch__thumb"></span></span>
						</span>
					</label>
					<p class="cc-category__desc">{analyticsDescription}</p>
				</div>
				<div class="cc-category">
					<label class="cc-category__row">
						<span class="cc-category__label">{adLabel}</span>
						<span class="cc-switch">
							<input type="checkbox" id="cc-advertising-toggle" />
							<span class="cc-switch__track"><span class="cc-switch__thumb"></span></span>
						</span>
					</label>
					<p class="cc-category__desc">{adDescription}</p>
				</div>
			</div>
		</div>

		<div class="cc-banner__actions">
			<button type="button" class="cc-btn cc-btn--text" id="cc-customize">{customizeLabel}</button>
			<button type="button" class="cc-btn cc-btn--secondary" id="cc-reject">{rejectLabel}</button>
			<button type="button" class="cc-btn cc-btn--secondary cc-btn--save" id="cc-save" hidden>
				{savePreferencesLabel}
			</button>
			<button type="button" class="cc-btn cc-btn--primary" id="cc-accept">{acceptAllLabel}</button>
		</div>

		<button type="button" class="cc-banner__close" id="cc-close" aria-label={closeLabel}>&times;</button>
	</div>
</div>

<script define:vars={{ GA_MEASUREMENT_ID, locale }}>
	const COOKIE_NAME = 'cc_consent';
	const COOKIE_DAYS = 365;
	const CONSENT_VERSION = 2;

	function setCookie(name, value, days) {
		const d = new Date();
		d.setTime(d.getTime() + days * 24 * 60 * 60 * 1000);
		document.cookie = `${name}=${encodeURIComponent(value)};expires=${d.toUTCString()};path=/;SameSite=Lax`;
	}

	function getCookie(name) {
		const match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
		return match ? decodeURIComponent(match[1]) : null;
	}

	function readConsent() {
		const raw = getCookie(COOKIE_NAME);
		if (!raw) return null;
		try {
			const c = JSON.parse(raw);
			return { v: c.v || 1, analytics: c.analytics === true, advertising: c.v >= 2 && c.advertising === true };
		} catch {
			return null;
		}
	}

	function saveConsent(consent) {
		setCookie(
			COOKIE_NAME,
			JSON.stringify({ v: CONSENT_VERSION, analytics: consent.analytics, advertising: consent.advertising, decidedAt: new Date().toISOString() }),
			COOKIE_DAYS,
		);
	}

	window.dataLayer = window.dataLayer || [];
	window.gtag = window.gtag || function gtag() { window.dataLayer.push(arguments); };

	function updateGoogleConsent(consent) {
		const ad = consent.advertising ? 'granted' : 'denied';
		window.gtag('consent', 'update', {
			analytics_storage: consent.analytics ? 'granted' : 'denied',
			ad_storage: ad,
			ad_user_data: ad,
			ad_personalization: ad,
		});
		window.gtag('set', 'ads_data_redaction', !consent.advertising);
	}

	let ga4Configured = false;
	function applyConsent(consent) {
		if (consent.analytics && !ga4Configured && GA_MEASUREMENT_ID && GA_MEASUREMENT_ID !== 'G-XXXXXXXXXX') {
			ga4Configured = true;
			window.gtag('config', GA_MEASUREMENT_ID, { anonymize_ip: true });
		}
	}

	const banner = document.getElementById('cc-banner');
	const categories = document.getElementById('cc-categories');
	const analyticsToggle = document.getElementById('cc-analytics-toggle');
	const advertisingToggle = document.getElementById('cc-advertising-toggle');
	const saveBtn = document.getElementById('cc-save');
	const rejectBtn = document.getElementById('cc-reject');
	const acceptBtn = document.getElementById('cc-accept');
	const customizeBtn = document.getElementById('cc-customize');
	const closeBtn = document.getElementById('cc-close');

	function showBanner(prefill) {
		if (!banner) return;
		if (analyticsToggle instanceof HTMLInputElement) analyticsToggle.checked = !!prefill?.analytics;
		if (advertisingToggle instanceof HTMLInputElement) advertisingToggle.checked = !!prefill?.advertising;
		banner.hidden = false;
		document.documentElement.classList.add('cc-open');
	}

	function hideBanner() {
		if (banner) banner.hidden = true;
		document.documentElement.classList.remove('cc-open');
	}

	function expand() {
		categories?.removeAttribute('hidden');
		saveBtn?.removeAttribute('hidden');
		customizeBtn?.setAttribute('hidden', '');
		banner?.classList.add('cc-banner--expanded');
	}

	function decide(consent) {
		saveConsent(consent);
		updateGoogleConsent(consent);
		applyConsent(consent);
		hideBanner();
		document.dispatchEvent(new CustomEvent('cc:change', { detail: consent }));
	}

	acceptBtn?.addEventListener('click', () => decide({ analytics: true, advertising: true }));
	rejectBtn?.addEventListener('click', () => decide({ analytics: false, advertising: false }));
	closeBtn?.addEventListener('click', () => decide({ analytics: false, advertising: false }));
	customizeBtn?.addEventListener('click', expand);
	saveBtn?.addEventListener('click', () =>
		decide({
			analytics: analyticsToggle instanceof HTMLInputElement && analyticsToggle.checked,
			advertising: advertisingToggle instanceof HTMLInputElement && advertisingToggle.checked,
		}),
	);

	// Reopen the banner on request (e.g. a "Manage Cookie Preferences" footer link).
	document.addEventListener('cc:open', () => {
		expand();
		showBanner(readConsent());
	});

	// Conversion tracking: fired by src/scripts/enquiryForm.ts on a successful submit.
	document.addEventListener('enquiry:success', () => {
		if (ga4Configured) window.gtag('event', 'generate_lead', { event_category: 'enquiry', send_to: GA_MEASUREMENT_ID });
	});

	const existing = readConsent();
	if (existing) applyConsent(existing);
	if (!existing || existing.v < CONSENT_VERSION) {
		if (existing) expand();
		showBanner(existing);
	}

	// Locale preference redirect: only on the bare English homepage, and only
	// if the visitor previously chose a different language via the navbar.
	if (location.pathname === '/') {
		const localeRoutes = { en: '/', fr: '/fr/', ru: '/ru/', bn: '/bn/', ro: '/ro/', es: '/es/', pt: '/pt/', vi: '/vi/', ar: '/ar/' };
		const preferred = getCookie('site_locale');
		if (preferred && preferred !== locale && localeRoutes[preferred]) {
			location.replace(localeRoutes[preferred]);
		}
	}
</script>

<style>
	/* Compact bottom bar: one sentence and three buttons, about 15% of a phone screen.
	   "Customize" expands it into the category switches. */
	.cc-banner {
		position: fixed;
		z-index: 9999;
		left: 0;
		right: 0;
		bottom: 0;
		max-height: 85vh;
		overflow-y: auto;
		padding: 10px 16px;
		background: var(--color-bg-white);
		border-top: 1px solid var(--color-border-card);
		box-shadow: 0 -4px 18px rgba(15, 23, 42, 0.12);
		font-family: var(--font-body);
	}

	.cc-banner[hidden] {
		display: none;
	}

	.cc-banner__inner {
		position: relative;
		max-width: 1120px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		gap: 8px 20px;
		padding-inline-end: 30px;
	}

	.cc-banner__main {
		flex: 1;
		min-width: 0;
	}

	.cc-banner__title {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}

	.cc-banner--expanded .cc-banner__title {
		position: static;
		width: auto;
		height: auto;
		margin: 0 0 4px;
		clip: auto;
		white-space: normal;
		font-family: var(--font-heading);
		font-size: 15px;
		font-weight: 700;
		color: var(--color-text-primary);
	}

	.cc-banner__desc {
		font-size: 13px;
		line-height: 1.45;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.cc-banner__link {
		color: var(--color-primary);
		font-weight: 600;
		text-decoration: underline;
		white-space: nowrap;
	}

	.cc-banner__categories {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-top: 10px;
		padding-top: 10px;
		border-top: 1px solid var(--color-border-light);
	}

	.cc-banner__categories[hidden] {
		display: none;
	}

	.cc-banner--expanded .cc-banner__inner {
		flex-direction: column;
		align-items: stretch;
	}

	.cc-category__row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		cursor: pointer;
	}

	.cc-category__label {
		font-size: 13.5px;
		font-weight: 700;
		color: var(--color-text-primary);
	}

	.cc-category__desc {
		font-size: 12.5px;
		color: var(--color-text-secondary);
		margin: 2px 0 0;
	}

	.cc-switch {
		position: relative;
		display: inline-flex;
	}

	.cc-switch--disabled {
		cursor: not-allowed;
		opacity: 0.6;
	}

	.cc-switch input {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		opacity: 0;
		cursor: inherit;
	}

	.cc-switch__track {
		width: 38px;
		height: 22px;
		border-radius: 999px;
		background: #9aa5b4;
		display: inline-flex;
		align-items: center;
		padding: 2px;
		transition: background 0.2s ease;
		flex-shrink: 0;
	}

	.cc-switch__thumb {
		width: 18px;
		height: 18px;
		border-radius: 50%;
		background: #fff;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
		transition: transform 0.2s ease;
	}

	.cc-switch input:checked + .cc-switch__track {
		background: var(--color-teal);
	}

	.cc-switch input:focus-visible + .cc-switch__track {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}

	.cc-switch input:checked + .cc-switch__track .cc-switch__thumb {
		transform: translateX(16px);
	}

	:global([dir='rtl']) .cc-switch input:checked + .cc-switch__track .cc-switch__thumb {
		transform: translateX(-16px);
	}

	.cc-banner__actions {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-shrink: 0;
	}

	.cc-btn {
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 700;
		padding: 8px 16px;
		border-radius: 999px;
		border: none;
		cursor: pointer;
		white-space: nowrap;
	}

	.cc-btn[hidden] {
		display: none;
	}

	.cc-btn--primary {
		background: var(--btn-primary-bg);
		color: var(--btn-primary-text);
	}

	.cc-btn--secondary {
		background: var(--btn-secondary-bg);
		color: var(--btn-secondary-text);
		border: 1px solid var(--btn-secondary-border);
	}

	.cc-btn--text {
		background: transparent;
		color: var(--color-text-secondary);
		text-decoration: underline;
		padding: 8px 4px;
	}

	.cc-banner__close {
		position: absolute;
		top: 50%;
		inset-inline-end: 0;
		transform: translateY(-50%);
		width: 26px;
		height: 26px;
		border-radius: 50%;
		border: 1px solid var(--color-border-light);
		background: var(--color-bg-white);
		color: var(--color-text-secondary);
		font-size: 16px;
		line-height: 1;
		cursor: pointer;
	}

	.cc-banner--expanded .cc-banner__close {
		top: 0;
		transform: none;
	}

	@media screen and (max-width: 760px) {
		.cc-banner {
			padding: 8px 12px 10px;
		}

		.cc-banner__inner {
			flex-direction: column;
			align-items: stretch;
			gap: 6px;
		}

		.cc-banner__close {
			top: 0;
			transform: none;
		}

		.cc-banner__desc {
			font-size: 12px;
		}

		.cc-banner__actions {
			flex-wrap: nowrap;
			gap: 6px;
		}

		.cc-btn {
			flex: 1 1 auto;
			min-width: 0;
			padding: 8px 6px;
			font-size: 12px;
			white-space: normal;
			line-height: 1.2;
			text-align: center;
		}

		.cc-btn--text {
			flex: 0 0 auto;
		}
	}
</style>
