---
// Site-wide search banner, rendered under the navbar on every page: a pastel
// India skyline backdrop, a heading, and a two-part search card — a city
// filter ("In or around") plus the free-text search. Results appear as a
// panel attached under the input while the visitor types, from a single
// locale-aware index covering doctors, hospitals and treatments.
import { getImage } from 'astro:assets';
import iconSearchGlass from 'bootstrap-icons/icons/search.svg?raw';
import iconGeo from 'bootstrap-icons/icons/geo-alt-fill.svg?raw';
import iconChevronDown from 'bootstrap-icons/icons/chevron-down.svg?raw';
import iconDoctor from 'bootstrap-icons/icons/person-badge-fill.svg?raw';
import iconHospitalType from 'bootstrap-icons/icons/hospital-fill.svg?raw';
import iconTreatment from 'bootstrap-icons/icons/heart-pulse-fill.svg?raw';
import iconClose from 'bootstrap-icons/icons/x-lg.svg?raw';
import pastelIndia from '../assets/banners/pastel-india.png';
import { buildSearchIndex } from '../utils/searchIndex';
import { destinations } from '../data/destinations';
import { localizeCity, type HospitalLocale } from '../i18n/hospitalNames';

export interface Props {
	locale?: string;
}

const { locale = 'en' } = Astro.props;

const index = buildSearchIndex(locale);
// Guard against "</script>" appearing inside any title/subtitle breaking out
// of the inline JSON payload below.
const indexJson = JSON.stringify(index).replace(/</g, '\\u003c');

const background = await getImage({ src: pastelIndia, format: 'webp', quality: 80 });

const STRINGS: Record<
	string,
	{
		title: string;
		tagline: [string, string, string];
		cityLabel: string;
		anyCity: string;
		queryLabel: string;
		placeholder: string;
		popularLabel: string;
		/** Heart transplant, knee replacement, IVF — the doctor link uses the index's localized name. */
		popular: [string, string, string];
		noResults: string;
		clear: string;
		doctors: string;
		hospitals: string;
		treatments: string;
	}
> = {
