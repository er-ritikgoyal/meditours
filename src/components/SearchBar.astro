		title: 'Спланируйте медицинскую поездку в Индию',
		tagline: ['Надёжно', 'Прозрачно', 'Безопасно'],
		cityLabel: 'Город:',
		anyCity: 'Любой город',
		queryLabel: 'Я ищу:',
		placeholder: 'Поиск врачей, больниц, клиник и процедур',
		popularLabel: 'Популярные запросы:',
		popular: ['Пересадка сердца', 'Эндопротезирование колена', 'ЭКО'],
		noResults: 'Ничего не найдено.',
		clear: 'Очистить поиск',
		doctors: 'Врачи',
		hospitals: 'Больницы',
		treatments: 'Процедуры',
	},
	bn: {
		title: 'ভারতে আপনার চিকিৎসা ভ্রমণের পরিকল্পনা করুন',
		tagline: ['বিশ্বস্ত', 'স্বচ্ছ', 'নির্ভরযোগ্য'],
		cityLabel: 'শহর বা আশেপাশে:',
		anyCity: 'যেকোনো শহর',
		queryLabel: 'আমি খুঁজছি:',
		placeholder: 'ডাক্তার, হাসপাতাল, ক্লিনিক ও চিকিৎসা খুঁজুন',
		popularLabel: 'জনপ্রিয় অনুসন্ধান:',
		popular: ['হৃদপিণ্ড প্রতিস্থাপন', 'হাঁটু প্রতিস্থাপন', 'আইভিএফ'],
		noResults: 'কোনো ফলাফল পাওয়া যায়নি।',
