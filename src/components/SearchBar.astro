		doctors: 'ডাক্তার',
		hospitals: 'হাসপাতাল',
		treatments: 'চিকিৎসা',
	},
	ro: {
		title: 'Planificați-vă călătoria medicală în India',
		tagline: ['De încredere', 'Transparent', 'Sigur'],
		cityLabel: 'În sau lângă:',
		anyCity: 'Orice oraș',
		queryLabel: 'Caut:',
		placeholder: 'Caută medici, spitale, clinici și tratamente',
		popularLabel: 'Căutări populare:',
		popular: ['Transplant de inimă', 'Protezare de genunchi', 'Fertilizare in vitro (FIV)'],
		noResults: 'Niciun rezultat găsit.',
		clear: 'Șterge căutarea',
		doctors: 'Medici',
		hospitals: 'Spitale',
		treatments: 'Tratamente',
	},
	vi: {
		title: 'Lên kế hoạch du lịch y tế đến Ấn Độ',
		tagline: ['Uy tín', 'Minh bạch', 'Đáng tin cậy'],
		cityLabel: 'Tại hoặc gần:',
		anyCity: 'Mọi thành phố',
		queryLabel: 'Tôi đang tìm:',
		placeholder: 'Tìm bác sĩ, bệnh viện, phòng khám và phương pháp điều trị',
		popularLabel: 'Tìm kiếm phổ biến:',
		popular: ['Ghép tim', 'Thay khớp gối', 'Thụ tinh trong ống nghiệm (IVF)'],
		noResults: 'Không tìm thấy kết quả.',
		clear: 'Xóa tìm kiếm',
		doctors: 'Bác sĩ',
		hospitals: 'Bệnh viện',
		treatments: 'Phương pháp điều trị',
	},
	ar: {
		title: 'خطّط لرحلتك العلاجية إلى الهند',
		tagline: ['موثوق', 'شفاف', 'جدير بالثقة'],
		cityLabel: 'في أو بالقرب من:',
		anyCity: 'أي مدينة',
		queryLabel: 'أبحث عن:',
		placeholder: 'ابحث عن أطباء، مستشفيات، عيادات وعلاجات',
		popularLabel: 'عمليات البحث الشائعة:',
		popular: ['زراعة القلب', 'استبدال مفصل الركبة', 'أطفال الأنابيب (IVF)'],
		noResults: 'لم يتم العثور على نتائج.',
		clear: 'مسح البحث',
		doctors: 'الأطباء',
		hospitals: 'المستشفيات',
		treatments: 'العلاجات',
	},
};

const s = STRINGS[locale] ?? STRINGS.en;
const prefix = locale === 'en' ? '/' : `/${locale}/`;

const cityOptions = destinations.map((d) => ({
	slug: d.slug,
	label: locale === 'en' ? d.city : localizeCity(d.city, locale as HospitalLocale),
}));

const featuredDoctorHref = `${prefix}doctors/gautam-banga`;
const featuredDoctor = index.find((item) => item.href === featuredDoctorHref);
const popularSearches = [
	{ label: s.popular[0], href: `${prefix}treatments/organ-transplant/heart-transplant` },
	{ label: s.popular[1], href: `${prefix}treatments/orthopedics/total-knee-replacement` },
	{ label: s.popular[2], href: `${prefix}treatments/fertility/in-vitro-fertilization-ivf` },
	...(featuredDoctor ? [{ label: featuredDoctor.title, href: featuredDoctorHref }] : []),
];
---

<section class="search-hero" style={`--search-hero-bg: url('${background.src}')`}>
	<div class="search-hero__inner">
		<p class="search-hero__title">{s.title}</p>
		<p class="search-hero__tagline">
			{s.tagline.map((word, i) => (i === 0 ? <span>{word}</span> : <><span class="search-hero__dot" aria-hidden="true">.</span><span>{word}</span></>))}
		</p>

		<div class="search-inline" id="search-inline">
			<div class="search-inline__fields">
				<div class="search-inline__field search-inline__field--city">
					<label class="search-inline__label" for="search-inline-city">
						{s.cityLabel}
						<span class="search-inline__label-icon" set:html={iconGeo} aria-hidden="true" />
					</label>
					<div class="search-inline__box search-inline__box--select">
						<select id="search-inline-city" class="search-inline__select">
							<option value="">{s.anyCity}</option>
							{cityOptions.map((city) => <option value={city.slug}>{city.label}</option>)}
						</select>
						<span class="search-inline__chevron" set:html={iconChevronDown} aria-hidden="true" />
					</div>
				</div>

				<div class="search-inline__field search-inline__field--query">
					<label class="search-inline__label" for="search-inline-input">{s.queryLabel}</label>
					<div class="search-inline__box">
						<span class="search-inline__bar-icon" set:html={iconSearchGlass} aria-hidden="true" />
						<input
							type="text"
							id="search-inline-input"
							class="search-inline__input"
							placeholder={s.placeholder}
							autocomplete="off"
							spellcheck="false"
						/>
						<button type="button" class="search-inline__clear" id="search-inline-clear" aria-label={s.clear} hidden>
							<span set:html={iconClose} aria-hidden="true" />
						</button>
					</div>
					<div class="search-inline__panel" id="search-inline-panel" hidden></div>
				</div>
			</div>

			<div class="search-inline__popular">
				<span class="search-inline__popular-label">{s.popularLabel}</span>
				{popularSearches.map((link) => <a href={link.href}>{link.label}</a>)}
			</div>
		</div>
	</div>
</section>

<script type="application/json" id="search-inline-data" set:html={indexJson} />

<script
	define:vars={{
		labels: { doctors: s.doctors, hospitals: s.hospitals, treatments: s.treatments },
		noResultsText: s.noResults,
		typeIcons: { doctor: iconDoctor, hospital: iconHospitalType, treatment: iconTreatment },
	}}
>
	const root = document.getElementById('search-inline');
	const input = document.getElementById('search-inline-input');
	const citySelect = document.getElementById('search-inline-city');
	const clearBtn = document.getElementById('search-inline-clear');
	const panel = document.getElementById('search-inline-panel');
	const dataEl = document.getElementById('search-inline-data');

	let items = [];
	try {
		items = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
	} catch {
		items = [];
	}

	const normalize = (value) =>
		value
			.toLowerCase()
			.normalize('NFD')
			.replace(/[̀-ͯ]/g, '');

	const escapeHtml = (value) =>
		value.replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch]);

	const groupOrder = [
		['doctor', labels.doctors],
		['hospital', labels.hospitals],
		['treatment', labels.treatments],
	];

	const hidePanel = () => {
		panel.hidden = true;
		panel.innerHTML = '';
	};

	// With a city picked, doctors and hospitals are limited to that city;
	// treatments aren't tied to a city, so they're always searchable. With a
	// city but no text, the panel lists that city's doctors and hospitals.
	const render = () => {
		const q = normalize(input.value.trim());
		const city = citySelect?.value || '';
		clearBtn.hidden = q.length === 0;

		if (!q && !city) {
			hidePanel();
			return;
		}

		const matches = items.filter((item) => {
			if (city && item.type !== 'treatment' && item.citySlug !== city) return false;
			if (!q) return item.type !== 'treatment';
			return item.haystack.includes(q);
		});

		if (matches.length === 0) {
			panel.innerHTML = `<p class="search-inline__empty">${noResultsText}</p>`;
			panel.hidden = false;
			return;
		}

		let html = '';
		for (const [type, label] of groupOrder) {
			const group = matches.filter((item) => item.type === type).slice(0, 6);
			if (group.length === 0) continue;
			html += `<div class="search-inline__group"><p class="search-inline__group-label">${escapeHtml(label)}</p><ul class="search-inline__list">`;
			for (const item of group) {
				const media = item.image
					? `<img class="search-inline__result-photo" src="${escapeHtml(item.image)}" alt="" loading="lazy" width="34" height="34" />`
					: `<span class="search-inline__result-icon">${typeIcons[item.type]}</span>`;
				html += `<li><a href="${escapeHtml(item.href)}" class="search-inline__result">
					${media}
					<span class="search-inline__result-text">
						<span class="search-inline__result-title">${escapeHtml(item.title)}</span>
						<span class="search-inline__result-subtitle">${escapeHtml(item.subtitle)}</span>
					</span>
				</a></li>`;
			}
			html += `</ul></div>`;
		}
		panel.innerHTML = html;
		panel.hidden = false;
	};

	input?.addEventListener('input', render);
	input?.addEventListener('focus', () => {
		if (input.value.trim() || citySelect?.value) render();
	});
	citySelect?.addEventListener('change', () => {
		render();
		input?.focus();
	});

	clearBtn?.addEventListener('click', () => {
		input.value = '';
		hidePanel();
		input.focus();
	});

	document.addEventListener('click', (e) => {
		if (!(e.target instanceof Node)) return;
		if (root && !root.contains(e.target)) hidePanel();
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && document.activeElement === input) {
			input.value = '';
			hidePanel();
			input.blur();
		}
	});

	panel?.addEventListener('click', (e) => {
		if (e.target instanceof Element && e.target.closest('a')) hidePanel();
	});
</script>

<style>
	.search-hero {
		position: relative;
		padding: 10px 24px 12px;
		background-color: #ece8f7;
		background-image: var(--search-hero-bg);
		background-size: cover;
		/* Anchor to the top so any cropping comes off the bottom of the image. */
		background-position: center top;
		font-family: var(--font-body);
	}

	.search-hero__inner {
		max-width: 1160px;
		margin: 0 auto;
		text-align: center;
	}

	.search-hero__title {
		margin: 0;
		font-family: var(--font-heading);
		font-size: clamp(18px, 1.9vw, 24px);
		font-weight: 700;
		line-height: 1.2;
		color: #0b1220;
	}

	.search-hero__tagline {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0 8px;
		margin: 0 0 8px;
		font-family: var(--font-heading);
		font-size: clamp(16px, 1.7vw, 22px);
		font-weight: 700;
		line-height: 1.25;
		color: var(--color-primary);
	}

	.search-hero__dot {
		color: var(--color-primary);
	}

	.search-inline {
		position: relative;
		max-width: 1160px;
		margin: 0 auto;
		padding: 8px 14px;
		text-align: start;
		background: rgba(255, 255, 255, 0.96);
		border-radius: 10px;
		box-shadow: var(--shadow-card);
	}

	.search-inline__fields {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.45fr);
		gap: 8px 24px;
	}

	.search-inline__field {
		position: relative;
		min-width: 0;
	}

	.search-inline__label {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		margin-bottom: 3px;
		font-family: var(--font-heading);
		font-size: 14px;
		font-weight: 500;
		color: var(--color-primary);
	}

	.search-inline__label-icon {
		display: flex;
		width: 14px;
		height: 14px;
	}

	.search-inline__label-icon :global(svg),
	.search-inline__chevron :global(svg),
	.search-inline__bar-icon :global(svg) {
		width: 100%;
		height: 100%;
	}

	.search-inline__box {
		position: relative;
		display: flex;
		align-items: center;
		gap: 10px;
		height: 36px;
		padding: 0 12px;
		background: var(--color-bg-white);
		border: 1.5px solid var(--color-primary);
		border-radius: 6px;
		transition: box-shadow 0.15s ease;
	}

	.search-inline__box:focus-within {
		box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.25);
	}

	.search-inline__box--select {
		padding: 0;
	}

	.search-inline__select {
		flex: 1;
		min-width: 0;
		height: 100%;
		padding-inline: 12px 34px;
		border: none;
		outline: none;
		background: transparent;
		font-family: inherit;
		font-size: 14px;
		color: var(--color-text-primary);
		cursor: pointer;
		appearance: none;
	}

	.search-inline__chevron {
		position: absolute;
		inset-inline-end: 12px;
		display: flex;
		width: 12px;
		height: 12px;
		color: var(--color-text-muted);
		pointer-events: none;
	}

	.search-inline__bar-icon {
		display: flex;
		width: 16px;
		height: 16px;
		flex-shrink: 0;
		color: var(--color-text-muted);
	}

	.search-inline__input {
		flex: 1;
		min-width: 0;
		border: none;
		outline: none;
		background: transparent;
		font-family: inherit;
		font-size: 14px;
		color: var(--color-text-primary);
	}

	.search-inline__input::placeholder {
		color: var(--color-text-muted);
	}

	.search-inline__clear {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 26px;
		height: 26px;
		flex-shrink: 0;
		border: none;
		border-radius: 50%;
		background: var(--color-bg-gray);
		color: var(--color-text-muted);
		cursor: pointer;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.search-inline__clear[hidden] {
		display: none;
	}

	.search-inline__clear:hover {
		background: var(--color-border-light);
		color: var(--color-text-primary);
	}

	.search-inline__clear :global(svg) {
		width: 11px;
		height: 11px;
	}

	.search-inline__popular {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 4px 22px;
		margin-top: 6px;
		font-size: 13.5px;
	}

	.search-inline__popular-label {
		font-family: var(--font-heading);
		font-weight: 500;
		color: var(--color-primary);
	}

	.search-inline__popular a {
		color: #e8731a;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.search-inline__popular a:hover {
		color: var(--color-primary);
	}

	.search-inline__panel {
		position: absolute;
		top: calc(100% + 6px);
		left: 0;
		right: 0;
		z-index: 40;
		max-height: 420px;
		overflow-y: auto;
		background: var(--color-bg-white);
		border: 1px solid var(--color-border-light);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
		padding: 8px;
	}

	.search-inline__panel[hidden] {
		display: none;
	}

	/*
	 * Everything below is injected client-side via `innerHTML` (see the
	 * render() function in the script above), so none of it is ever part of
	 * this component's compiled template — Astro can't attach its scoping
	 * attribute to elements that don't exist at build time. Every rule for
	 * injected markup must therefore be :global(), or it silently never
	 * matches (e.g. an unsized <img> rendering at its native pixel size).
	 */
	:global(.search-inline__empty) {
		margin: 0;
		padding: 20px 12px;
		text-align: center;
		font-size: 13.5px;
		color: var(--color-text-muted);
	}

	:global(.search-inline__group) {
		padding: 6px 4px;
	}

	:global(.search-inline__group) + :global(.search-inline__group) {
		border-top: 1px solid var(--color-border-light);
		margin-top: 2px;
	}

	:global(.search-inline__group-label) {
