		title: 'Planeje sua viagem médica para a Índia',
		tagline: ['Confiável', 'Transparente', 'Seguro'],
		cityLabel: 'Em ou perto de:',
		anyCity: 'Qualquer cidade',
		queryLabel: 'Estou procurando:',
		placeholder: 'Pesquisar médicos, hospitais, clínicas e tratamentos',
