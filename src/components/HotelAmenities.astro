---
import iconWifi from 'bootstrap-icons/icons/wifi.svg?raw';
import iconShuttle from 'bootstrap-icons/icons/bus-front-fill.svg?raw';
import iconBell from 'bootstrap-icons/icons/bell-fill.svg?raw';
import iconMeal from 'bootstrap-icons/icons/cup-hot-fill.svg?raw';
import iconAccessible from 'bootstrap-icons/icons/person-wheelchair.svg?raw';
import iconDesk from 'bootstrap-icons/icons/moon-stars-fill.svg?raw';
import iconLaundry from 'bootstrap-icons/icons/basket-fill.svg?raw';
import iconAc from 'bootstrap-icons/icons/snow.svg?raw';

export interface Props {
	badge?: string;
	titleLead?: string;
	titleHighlight?: string;
	subtitle?: string;
	labels?: string[];
}

const amenityIcons = [iconWifi, iconShuttle, iconBell, iconMeal, iconAccessible, iconDesk, iconLaundry, iconAc];
const amenityThemes = ['blue', 'teal', 'green', 'blue', 'teal', 'green', 'blue', 'teal'] as const;

const {
	badge = 'Built for Recovery',
	titleLead = 'Every Stay Comes',
	titleHighlight = 'Patient-Ready',
	subtitle = 'Standard across every accommodation tier, so you never have to ask twice.',
	labels = [
		'Free Wi-Fi',
		'Hospital Shuttle',
		'Nurse Call Assistance',
		'Dietary Meal Plans',
		'Wheelchair Accessible',
		'24/7 Front Desk',
		'Laundry Service',
		'Air Conditioning',
	],
} = Astro.props;

const amenities = labels.map((label, i) => ({ label, icon: amenityIcons[i], theme: amenityThemes[i] }));
---

<section class="amenities">
	<div class="amenities__inner">
		<div class="amenities__header" data-animate>
			<span class="amenities__badge">{badge}</span>
			<h2 class="amenities__title">
				{titleLead} <span>{titleHighlight}</span>
			</h2>
			<p class="amenities__subtitle">{subtitle}</p>
		</div>

		<div class="amenities__grid">
			{
				amenities.map((amenity, i) => (
					<div class="amenity" data-animate style={`transition-delay: ${(i % 4) * 80}ms`}>
						<span class={`amenity__icon amenity__icon--${amenity.theme}`} set:html={amenity.icon} aria-hidden="true" />
						<span class="amenity__label">{amenity.label}</span>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const animated = document.querySelectorAll('.amenities [data-animate]');

	if (prefersReducedMotion) {
		animated.forEach((el) => el.classList.add('is-visible'));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 }
		);
		animated.forEach((el) => observer.observe(el));
	}
</script>

<style>
	.amenities {
		background: var(--color-bg-alt);
		padding: 80px 24px;
		font-family: var(--font-body);
	}

	.amenities__inner {
		max-width: 1100px;
		margin: 0 auto;
	}

	[data-animate] {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}

	[data-animate].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.amenities__header {
		text-align: center;
		max-width: 560px;
		margin: 0 auto 48px;
	}

	.amenities__badge {
		display: inline-block;
		padding: 7px 18px;
		border-radius: 999px;
		border: 1px solid var(--color-border-card);
		background: var(--color-bg-white);
		color: var(--color-primary);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		margin-bottom: 20px;
	}

	.amenities__title {
		font-family: var(--font-heading);
		font-size: clamp(1.7rem, 3vw, 2.3rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-text-primary);
		margin: 0;
	}

	.amenities__title span {
		color: var(--color-teal);
	}

	.amenities__subtitle {
		margin-top: 14px;
		font-size: 1rem;
		color: var(--color-text-secondary);
	}

	.amenities__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
	}

	.amenity {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 14px;
		padding: 26px 16px;
		background: var(--color-bg-white);
		border: 1px solid var(--color-border-card);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-soft);
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}

	.amenity:hover {
		transform: translateY(-6px);
		box-shadow: var(--shadow-card);
	}

	.amenity:hover .amenity__icon {
		animation: amenity-float 1.6s ease-in-out infinite;
	}

	.amenity__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		color: #ffffff;
	}

	.amenity__icon :global(svg) {
		width: 22px;
		height: 22px;
	}

	.amenity__icon--blue {
		background: linear-gradient(135deg, var(--color-primary) 0%, #2f6fa8 100%);
	}

	.amenity__icon--teal {
		background: linear-gradient(135deg, #0f766e 0%, var(--color-teal) 100%);
	}

	.amenity__icon--green {
		background: linear-gradient(135deg, #15803d 0%, var(--color-green) 100%);
	}

	.amenity__label {
		font-size: 13.5px;
		font-weight: 600;
		color: var(--color-text-primary);
	}

	@keyframes amenity-float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-6px);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.amenity:hover .amenity__icon {
			animation: none;
		}
	}

	@media screen and (max-width: 860px) {
		.amenities__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media screen and (max-width: 640px) {
		.amenities {
			padding: 56px 16px;
		}
	}
</style>
