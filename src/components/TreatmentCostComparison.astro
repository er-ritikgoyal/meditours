---
import iconJoints from 'healthicons/public/icons/svg/outline/body/joints.svg?raw';
import iconOrthopaedics from 'healthicons/public/icons/svg/outline/specialties/orthopaedics.svg?raw';
import iconNeurology from 'healthicons/public/icons/svg/outline/body/neurology.svg?raw';
import iconHeartOrgan from 'healthicons/public/icons/svg/outline/body/heart_organ.svg?raw';
import iconCardiology from 'healthicons/public/icons/svg/outline/specialties/cardiology.svg?raw';
import iconBreasts from 'healthicons/public/icons/svg/outline/body/breasts.svg?raw';
import iconLungs from 'healthicons/public/icons/svg/outline/body/lungs.svg?raw';
import iconNose from 'healthicons/public/icons/svg/outline/body/nose.svg?raw';
import iconScissors from 'bootstrap-icons/icons/scissors.svg?raw';
import iconGynecology from 'healthicons/public/icons/svg/outline/specialties/gynecology.svg?raw';
import iconWhatsapp from 'bootstrap-icons/icons/whatsapp.svg?raw';

export interface QuoteTreatment {
	name: string;
	startingPrice: number;
	icon: string;
}

export interface Props {
	title?: string;
	subtitle?: string;
	discoverText?: string;
	getQuoteLabel?: string;
	chatLabel?: string;
	basePath?: string;
	whatsappNumber?: string;
	whatsappMessage?: string;
	treatments?: QuoteTreatment[];
}

const defaultTreatments: QuoteTreatment[] = [
	{ name: 'Knee Replacement', startingPrice: 4000, icon: iconJoints },
	{ name: 'Hip Replacement', startingPrice: 5500, icon: iconOrthopaedics },
	{ name: 'Brain Tumor', startingPrice: 5000, icon: iconNeurology },
	{ name: 'Heart Bypass Surgery', startingPrice: 4500, icon: iconHeartOrgan },
	{ name: 'Valve Replacement', startingPrice: 9500, icon: iconCardiology },
	{ name: 'Breast Cancer', startingPrice: 5000, icon: iconBreasts },
	{ name: 'Lung Cancer', startingPrice: 5500, icon: iconLungs },
	{ name: 'Rhinoplasty', startingPrice: 1800, icon: iconNose },
	{ name: 'Breast Implants', startingPrice: 2750, icon: iconBreasts },
	{ name: 'Hair Transplant', startingPrice: 1400, icon: iconScissors },
	{ name: 'IVF Treatment', startingPrice: 3500, icon: iconGynecology },
	{ name: 'Hysterectomy', startingPrice: 3000, icon: iconGynecology },
];

const {
	title = 'Lowest Quotes Assured',
	subtitle = 'We constantly negotiate better prices and alternatives without compromising treatment quality. Our prices are consistently lower.',
	discoverText = 'Discover what we offer!',
	getQuoteLabel = 'Get Quote',
	chatLabel = 'Chat',
	basePath = '',
	whatsappNumber = '919821701155',
	whatsappMessage = 'Hello, I am interested in the services listed on your website',
	treatments = defaultTreatments,
} = Astro.props;

const formatPrice = (value: number) => `$${value.toLocaleString('en-US')}`;
const quoteHref = `${basePath}/contact#enquiry-form`;
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<section class="quotes">
	<div class="quotes__inner">
		<div class="quotes__header" data-animate>
			<h2 class="quotes__title">{title}</h2>
			<p class="quotes__subtitle">{subtitle}</p>
		</div>

		<div class="quotes__grid">
			{
				treatments.map((treatment, i) => (
					<div class="quote-card" data-animate style={`transition-delay: ${Math.min(i, 7) * 50}ms`}>
						<span class="quote-card__icon" set:html={treatment.icon} aria-hidden="true" />
						<div class="quote-card__body">
							<h3 class="quote-card__name">{treatment.name}</h3>
							<p class="quote-card__price">
								Starting <strong>{formatPrice(treatment.startingPrice)}</strong>
							</p>
							<a class="quote-card__link" href={quoteHref}>
								{getQuoteLabel}
							</a>
						</div>
					</div>
				))
			}
		</div>

		<div class="quotes__footer" data-animate>
			<p class="quotes__discover">{discoverText}</p>
			<div class="quotes__actions">
				<a class="quotes__btn quotes__btn--quote" href={quoteHref}>
					{getQuoteLabel}
				</a>
				<a class="quotes__btn quotes__btn--chat" href={whatsappHref} target="_blank" rel="noopener noreferrer">
					<span set:html={iconWhatsapp} aria-hidden="true" />
					{chatLabel}
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const animated = document.querySelectorAll('.quotes [data-animate]');

	if (prefersReducedMotion) {
		animated.forEach((el) => el.classList.add('is-visible'));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.12 },
		);
		animated.forEach((el) => observer.observe(el));
	}
</script>

<style>
	.quotes {
		background: var(--color-bg-white);
		padding: 80px 24px 88px;
		font-family: var(--font-body);
	}

	.quotes__inner {
		max-width: 1320px;
		margin: 0 auto;
	}

	[data-animate] {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}

	[data-animate].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.quotes__header {
		text-align: center;
		max-width: 640px;
		margin: 0 auto 40px;
	}

	.quotes__title {
		font-family: var(--font-heading);
		font-size: clamp(1.8rem, 3.2vw, 2.4rem);
		font-weight: 700;
		color: var(--color-primary);
		margin: 0 0 12px;
	}

	.quotes__subtitle {
		font-size: 15px;
		line-height: 1.7;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.quotes__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 18px;
	}

	.quote-card {
		display: flex;
		align-items: flex-start;
		gap: 14px;
		padding: 18px;
		background: var(--color-bg-soft-blue);
		border: 1px solid var(--color-border-card);
		border-radius: var(--radius-md);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.quote-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-soft);
	}

	.quote-card__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: #ffffff;
		color: var(--color-primary);
		box-shadow: 0 0 0 1px var(--color-border-card);
	}

	.quote-card__icon :global(svg) {
		width: 26px;
		height: 26px;
	}

	.quote-card__body {
		min-width: 0;
	}

	.quote-card__name {
		font-family: var(--font-heading);
		font-size: 15.5px;
		font-weight: 700;
		color: var(--color-primary);
		margin: 0 0 2px;
	}

	.quote-card__price {
		font-size: 13.5px;
		color: var(--color-text-secondary);
		margin: 0 0 4px;
	}

	.quote-card__price strong {
		color: var(--color-text-primary);
		font-weight: 700;
	}

	.quote-card__link {
		display: inline-block;
		font-size: 13px;
		font-weight: 700;
		color: var(--color-danger);
		text-decoration: none;
	}

	.quote-card__link:hover {
		text-decoration: underline;
	}

	.quotes__footer {
		text-align: center;
		margin-top: 48px;
	}

	.quotes__discover {
		font-size: 14.5px;
		color: var(--color-text-muted);
		margin: 0 0 18px;
	}

	.quotes__actions {
		display: inline-flex;
		align-items: center;
		gap: 14px;
	}

	.quotes__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		padding: 13px 32px;
		border-radius: 999px;
		font-size: 14.5px;
		font-weight: 700;
		text-decoration: none;
		cursor: pointer;
		transition:
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}

	.quotes__btn:hover {
		transform: translateY(-2px);
	}

	.quotes__btn--quote {
		background: var(--color-danger);
		color: #ffffff;
		box-shadow: 0 8px 20px -8px rgba(239, 68, 68, 0.55);
	}

	.quotes__btn--chat {
		background: #25d366;
		color: #ffffff;
		box-shadow: 0 8px 20px -8px rgba(37, 211, 102, 0.55);
	}

	.quotes__btn--chat :global(svg) {
		width: 17px;
		height: 17px;
	}

	@media screen and (max-width: 1080px) {
		.quotes__grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media screen and (max-width: 760px) {
		.quotes__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media screen and (max-width: 520px) {
		.quotes {
			padding: 56px 16px 64px;
		}

		.quotes__grid {
			grid-template-columns: 1fr;
		}

		.quotes__actions {
			flex-direction: column;
			width: 100%;
		}

		.quotes__btn {
			width: 100%;
		}
	}
</style>
