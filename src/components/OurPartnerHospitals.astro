---
import { Image } from 'astro:assets';
import iconHospital from 'bootstrap-icons/icons/hospital-fill.svg?raw';
import iconGeo from 'bootstrap-icons/icons/geo-alt-fill.svg?raw';
import iconAward from 'bootstrap-icons/icons/award-fill.svg?raw';
import iconBed from 'bootstrap-icons/icons/building-fill-check.svg?raw';
import iconArrow from 'bootstrap-icons/icons/arrow-right-short.svg?raw';
import iconDownload from 'bootstrap-icons/icons/file-earmark-arrow-down.svg?raw';
import { getFeaturedHospitals, type HospitalData } from '../data/hospitals';

export type Hospital = HospitalData;

export interface Props {
	badge?: string;
	title?: string;
	highlight?: string;
	subtitle?: string;
	hospitals?: Hospital[];
	viewMoreLabel?: string;
	viewMoreHref?: string;
	/** Locale URL prefix, e.g. "/fr" — defaults to root (English). */
	basePath?: string;
}

const {
	badge = 'Our Network',
	title = 'Our Partner',
	highlight = 'Hospitals',
	subtitle = 'We work only with accredited hospitals that meet international standards for safety, hygiene, and clinical outcomes.',
	hospitals = getFeaturedHospitals(2),
	viewMoreLabel = 'View More Hospitals',
	viewMoreHref = '/destinations',
	basePath = '',
} = Astro.props;
---

<section class="hospitals">
	<div class="hospitals__inner">
		<div class="hospitals__header" data-animate>
			<span class="hospitals__badge">{badge}</span>
			<h2 class="hospitals__title">
				{title} <span>{highlight}</span>
			</h2>
			<p class="hospitals__subtitle">{subtitle}</p>
		</div>

		<div class="hospitals__grid">
			{
				hospitals.map((hospital, i) => (
					<a
						class="hospital-card"
						href={`${basePath}/hospitals/${hospital.slug}`}
						data-animate
						style={`transition-delay: ${(i % 3) * 90}ms`}
					>
						{hospital.image ? (
							<div class="hospital-card__media hospital-card__media--photo">
								<Image src={hospital.image} alt={hospital.name} width={480} height={220} loading="lazy" data-hospital-img />
								<div
									class={`hospital-card__media-fallback hospital-card__media-fallback--${hospital.theme ?? 'blue'}`}
									data-hospital-img-fallback
									hidden
								>
									<span set:html={iconHospital} aria-hidden="true" />
								</div>
							</div>
						) : (
							<div class={`hospital-card__media hospital-card__media--${hospital.theme ?? 'blue'}`}>
								<span class="hospital-card__icon" set:html={iconHospital} aria-hidden="true" />
							</div>
						)}
						<div class="hospital-card__body">
							<h3 class="hospital-card__name">{hospital.name}</h3>
							<p class="hospital-card__location">
								<span set:html={iconGeo} aria-hidden="true" />
								{hospital.city}, {hospital.country}
							</p>

							<span class="hospital-card__accreditation">
								<span set:html={iconAward} aria-hidden="true" />
								{hospital.accreditation}
							</span>

							<ul class="hospital-card__tags">
								{hospital.specialties.map((specialty) => (
									<li>{specialty}</li>
								))}
							</ul>

							<p class="hospital-card__beds">
								<span set:html={iconBed} aria-hidden="true" />
								{hospital.beds}
							</p>

							
						</div>
					</a>
				))
			}
		</div>

		<div class="hospitals__view-more" data-animate>
			<a class="hospitals__view-more-btn" href={viewMoreHref}>
				{viewMoreLabel}
				<span set:html={iconArrow} aria-hidden="true" />
			</a>
		</div>
	</div>
</section>

<script>
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const animated = document.querySelectorAll('.hospitals [data-animate]');

	if (prefersReducedMotion) {
		animated.forEach((el) => el.classList.add('is-visible'));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 }
		);
		animated.forEach((el) => observer.observe(el));
	}

	document.querySelectorAll<HTMLImageElement>('[data-hospital-img]').forEach((img) => {
		img.addEventListener(
			'error',
			() => {
				img.style.display = 'none';
				img.parentElement?.querySelector('[data-hospital-img-fallback]')?.removeAttribute('hidden');
			},
			{ once: true }
		);
	});

	document.querySelectorAll<HTMLButtonElement>('[data-hospital-download]').forEach((btn) => {
		btn.addEventListener('click', (event) => {
			// The button sits inside the now-clickable hospital-card <a> — stop the
			// click from also triggering that link's navigation.
			event.preventDefault();
			event.stopPropagation();

			const profileUrl = btn.dataset.profileUrl;
			if (!profileUrl) return; // no profile document for this hospital yet

			const link = document.createElement('a');
			link.href = profileUrl;
			link.download = '';
			document.body.appendChild(link);
			link.click();
			link.remove();
		});
	});
</script>

<style>
	.hospitals {
		background: var(--color-bg-alt);
		padding: 80px 24px 88px;
		font-family: var(--font-body);
	}

	.hospitals__inner {
		max-width: 1320px;
		margin: 0 auto;
	}

	[data-animate] {
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}

	[data-animate].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.hospitals__header {
		text-align: center;
		max-width: 640px;
		margin: 0 auto 48px;
	}

	.hospitals__badge {
		display: inline-block;
		padding: 7px 18px;
		border-radius: 999px;
		border: 1px solid var(--color-border-card);
		background: var(--color-bg-white);
		color: var(--color-primary);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		margin-bottom: 20px;
	}

	.hospitals__title {
		font-family: var(--font-heading);
		font-size: clamp(1.8rem, 3.2vw, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-text-primary);
		margin: 0;
	}

	.hospitals__title span {
		color: var(--color-teal);
	}

	.hospitals__subtitle {
		margin-top: 14px;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.hospitals__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 24px;
	}

	.hospital-card {
		display: flex;
		flex-direction: column;
		background: var(--color-bg-white);
		border: 1px solid var(--color-border-card);
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease,
			opacity 0.6s ease;
	}

	.hospital-card:hover {
		transform: translateY(-6px);
		box-shadow: var(--shadow-card);
	}

	.hospital-card__media {
		display: flex;
		align-items: center;
		justify-content: center;
		height: 166px;
	}

	.hospital-card__media--blue {
		background: linear-gradient(135deg, var(--color-primary) 0%, #2f6fa8 100%);
	}

	.hospital-card__media--teal {
		background: linear-gradient(135deg, #0f766e 0%, var(--color-teal) 100%);
	}

	.hospital-card__media--green {
		background: linear-gradient(135deg, #15803d 0%, var(--color-green) 100%);
	}

	.hospital-card__media--photo {
		position: relative;
		padding: 0;
	}

	.hospital-card__media--photo :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hospital-card__media-fallback {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.hospital-card__media-fallback[hidden] {
		display: none;
	}

	.hospital-card__media-fallback span {
		display: flex;
		width: 40px;
		height: 40px;
		color: rgba(255, 255, 255, 0.92);
	}

	.hospital-card__media-fallback span :global(svg) {
		width: 100%;
		height: 100%;
	}

	.hospital-card__media-fallback--blue {
		background: linear-gradient(135deg, var(--color-primary) 0%, #2f6fa8 100%);
	}

	.hospital-card__media-fallback--teal {
		background: linear-gradient(135deg, #0f766e 0%, var(--color-teal) 100%);
	}

	.hospital-card__media-fallback--green {
		background: linear-gradient(135deg, #15803d 0%, var(--color-green) 100%);
	}

	.hospital-card__icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.16);
		border: 1px solid rgba(255, 255, 255, 0.4);
		color: #ffffff;
	}

	.hospital-card__icon :global(svg) {
		width: 24px;
		height: 24px;
	}

	.hospital-card__body {
		display: flex;
		flex-direction: column;
		flex: 1;
		padding: 22px 22px 24px;
	}

	.hospital-card__name {
		font-family: var(--font-heading);
		font-size: 17px;
		font-weight: 700;
		color: var(--color-text-primary);
		margin: 0 0 6px;
	}

	.hospital-card__location {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 12.5px;
		color: var(--color-text-muted);
		margin: 0 0 14px;
	}

	.hospital-card__location span {
		display: flex;
		flex-shrink: 0;
		width: 12px;
		height: 12px;
		color: var(--color-primary);
	}

	.hospital-card__location span :global(svg) {
		width: 100%;
		height: 100%;
	}

	.hospital-card__accreditation {
		display: inline-flex;
		align-self: flex-start;
		align-items: center;
		gap: 6px;
		padding: 5px 12px;
		border-radius: 999px;
		background: var(--color-bg-soft-blue);
		color: var(--color-primary);
		font-size: 11.5px;
		font-weight: 700;
		margin-bottom: 16px;
	}

	.hospital-card__accreditation span {
		display: flex;
		width: 12px;
		height: 12px;
		color: var(--color-gold);
	}

	.hospital-card__accreditation span :global(svg) {
		width: 100%;
		height: 100%;
	}

	.hospital-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		list-style: none;
		margin: 0 0 18px;
		padding: 0;
	}

	.hospital-card__tags li {
		padding: 4px 10px;
		border-radius: 999px;
		background: var(--color-bg-gray);
		color: var(--color-text-secondary);
		font-size: 11px;
		font-weight: 600;
	}

	.hospital-card__beds {
		display: flex;
		align-items: center;
		gap: 6px;
		margin: auto 0 0;
		padding-top: 14px;
		border-top: 1px solid var(--color-border-light);
		font-size: 12.5px;
		font-weight: 600;
		color: var(--color-text-primary);
	}

	.hospital-card__beds span {
		display: flex;
		width: 13px;
		height: 13px;
		color: var(--color-teal);
	}

	.hospital-card__beds span :global(svg) {
		width: 100%;
		height: 100%;
	}

	.hospital-card__download {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		width: 100%;
		margin-top: 14px;
		padding: 10px 16px;
		border-radius: var(--radius-md);
		background: var(--btn-secondary-bg);
		border: 1px solid var(--btn-secondary-border);
		color: var(--btn-secondary-text);
		font-family: var(--font-body);
		font-size: 13px;
		font-weight: 600;
		cursor: pointer;
		transition: background 0.15s ease;
	}

	.hospital-card__download:hover {
		background: var(--btn-secondary-hover-bg);
	}

	.hospital-card__download :global(svg) {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
	}

	.hospitals__view-more {
		display: flex;
		justify-content: center;
		margin-top: 44px;
	}

	.hospitals__view-more-btn {
		display: inline-flex;
		align-items: center;
		gap: 2px;
		padding: 14px 28px;
		border-radius: var(--radius-md);
		background: var(--btn-primary-bg);
		color: var(--btn-primary-text);
		font-size: 15px;
		font-weight: 600;
		text-decoration: none;
		box-shadow: var(--shadow-soft);
		transition:
			background 0.15s ease,
			transform 0.15s ease,
			box-shadow 0.15s ease;
	}

	.hospitals__view-more-btn:hover {
		background: var(--btn-primary-hover);
		transform: translateY(-2px);
		box-shadow: var(--shadow-card);
	}

	.hospitals__view-more-btn :global(svg) {
		width: 20px;
		height: 20px;
	}

	@media screen and (max-width: 640px) {
		.hospitals {
			padding: 56px 16px 64px;
		}

		.hospitals__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
