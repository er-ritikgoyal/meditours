---
import iconRocket from 'bootstrap-icons/icons/rocket-takeoff-fill.svg?raw';
import iconBuilding from 'bootstrap-icons/icons/building-fill-check.svg?raw';
import iconGlobe from 'bootstrap-icons/icons/globe-americas.svg?raw';
import iconFlag from 'bootstrap-icons/icons/flag-fill.svg?raw';
import iconPatch from 'bootstrap-icons/icons/patch-check-fill.svg?raw';
import iconTrophy from 'bootstrap-icons/icons/trophy-fill.svg?raw';

export interface Milestone {
	title: string;
	description: string;
}

export interface Props {
	badge?: string;
	titleLead?: string;
	titleHighlight?: string;
	subtitle?: string;
	milestones?: Milestone[];
}

const milestoneYears = ['2015', '2017', '2019', '2021', '2023', 'Today'];
const milestoneIcons = [iconRocket, iconBuilding, iconGlobe, iconFlag, iconPatch, iconTrophy];
const milestoneThemes = ['blue', 'teal', 'green', 'blue', 'teal', 'green'] as const;

const {
	badge = 'Our Journey',
	titleLead = '5+ Years of Building',
	titleHighlight = 'Patient Trust',
	subtitle = 'From a small coordinator team to a patient network spanning 40+ countries.',
	milestones: milestonesProp = [
		{ title: 'Founded in Mumbai', description: 'Alis Pro Med Tour launches with a handful of partner hospitals across Delhi and Mumbai.' },
		{
			title: 'Accreditation Network Grows',
			description: "Expanded to 100+ JCI and NABH-accredited hospitals across India's top medical hubs.",
		},
		{
			title: 'Global Expansion',
			description: 'Began serving patients from over 20 countries, with dedicated visa and travel support.',
		},
		{
			title: '5,000 Patients Milestone',
			description: 'Crossed 5,000 successfully treated international patients despite global travel disruption.',
		},
		{
			title: '24/7 Concierge Launch',
			description: 'Introduced round-the-clock multilingual patient support and dedicated case coordinators.',
		},
		{
			title: '40+ Countries, 10,000+ Patients',
			description: 'Supporting patients from 40+ countries across 100+ accredited partner hospitals nationwide.',
		},
	],
} = Astro.props;

const milestones = milestonesProp.map((milestone, i) => ({
	...milestone,
	year: milestoneYears[i],
	icon: milestoneIcons[i],
	theme: milestoneThemes[i],
}));
---

<section class="journey">
	<div class="journey__inner">
		<div class="journey__header" data-animate>
			<span class="journey__badge">{badge}</span>
			<h2 class="journey__title">
				{titleLead} <span>{titleHighlight}</span>
			</h2>
			<p class="journey__subtitle">{subtitle}</p>
		</div>

		<ol class="journey__timeline">
			{
				milestones.map((milestone, i) => (
					<li class="journey__item" data-animate style={`transition-delay: ${(i % 3) * 100}ms`}>
						<span class={`journey__dot journey__dot--${milestone.theme}`} set:html={milestone.icon} />
						<div class="journey__content">
							<span class="journey__year">{milestone.year}</span>
							<h3>{milestone.title}</h3>
							<p>{milestone.description}</p>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<script>
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const animated = document.querySelectorAll('.journey [data-animate]');

	if (prefersReducedMotion) {
		animated.forEach((el) => el.classList.add('is-visible'));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 }
		);
		animated.forEach((el) => observer.observe(el));
	}
</script>

<style>
	.journey {
		background: var(--color-bg-white);
		padding: 80px 24px;
		font-family: var(--font-body);
	}

	.journey__inner {
		max-width: 780px;
		margin: 0 auto;
	}

	[data-animate] {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}

	[data-animate].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.journey__header {
		text-align: center;
		max-width: 560px;
		margin: 0 auto 56px;
	}

	.journey__badge {
		display: inline-block;
		padding: 7px 18px;
		border-radius: 999px;
		border: 1px solid var(--color-border-card);
		background: var(--color-bg-white);
		color: var(--color-primary);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		margin-bottom: 20px;
	}

	.journey__title {
		font-family: var(--font-heading);
		font-size: clamp(1.7rem, 3vw, 2.3rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-text-primary);
		margin: 0;
	}

	.journey__title span {
		color: var(--color-teal);
	}

	.journey__subtitle {
		margin-top: 14px;
		font-size: 1rem;
		color: var(--color-text-secondary);
	}

	.journey__timeline {
		position: relative;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.journey__timeline::before {
		content: '';
		position: absolute;
		top: 8px;
		bottom: 8px;
		inset-inline-start: 27px;
		width: 2px;
		background: var(--color-border-card);
	}

	.journey__item {
		position: relative;
		display: flex;
		gap: 24px;
		padding-bottom: 40px;
	}

	.journey__item:last-child {
		padding-bottom: 0;
	}

	.journey__dot {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 56px;
		height: 56px;
		border-radius: 50%;
		border: 4px solid var(--color-bg-white);
		color: #ffffff;
		box-shadow: var(--shadow-soft);
	}

	.journey__dot :global(svg) {
		width: 22px;
		height: 22px;
	}

	.journey__dot--blue {
		background: linear-gradient(135deg, var(--color-primary) 0%, #2f6fa8 100%);
	}

	.journey__dot--teal {
		background: linear-gradient(135deg, #0f766e 0%, var(--color-teal) 100%);
	}

	.journey__dot--green {
		background: linear-gradient(135deg, #15803d 0%, var(--color-green) 100%);
	}

	.journey__content {
		flex: 1;
		padding: 12px 20px;
		background: var(--color-bg-white);
		border: 1px solid var(--color-border-card);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-soft);
	}

	.journey__year {
		display: inline-block;
		font-family: var(--font-heading);
		font-size: 12px;
		font-weight: 700;
		color: var(--color-teal);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 4px;
	}

	.journey__content h3 {
		font-family: var(--font-heading);
		font-size: 16px;
		font-weight: 700;
		color: var(--color-text-primary);
		margin: 0 0 6px;
	}

	.journey__content p {
		font-size: 13.5px;
		line-height: 1.6;
		color: var(--color-text-secondary);
		margin: 0;
	}

	@media screen and (max-width: 640px) {
		.journey {
			padding: 56px 16px;
		}

		.journey__timeline::before {
			inset-inline-start: 23px;
		}

		.journey__dot {
			width: 48px;
			height: 48px;
		}

		.journey__dot :global(svg) {
			width: 18px;
			height: 18px;
		}

		.journey__item {
			gap: 16px;
		}
	}
</style>
