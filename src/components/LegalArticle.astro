---
/**
 * Layout for the English legal pages (privacy, terms, cookies, medical disclaimer).
 * The text lives in src/legal/*.md and is rendered into the slot.
 */
import Layout from '../layouts/Layout.astro';
import PageHeader from './PageHeader.astro';

interface Props {
	title: string;
	description: string;
	effectiveDate: string;
}

const { title, description, effectiveDate } = Astro.props;
---

<Layout title={`${title} | AlisPro MediTours`} description={description}>
	<PageHeader title={title} subtitle={`Effective date: ${effectiveDate}`} breadcrumbs={[{ label: title }]} />

	<section class="legal-page">
		<div class="legal-page__inner">
			<slot />
		</div>
	</section>
</Layout>

<style>
	.legal-page {
		background: var(--color-bg-white);
		padding: 56px 24px 88px;
		font-family: var(--font-body);
	}

	.legal-page__inner {
		max-width: 760px;
		margin: 0 auto;
	}

	.legal-page__inner :global(p) {
		font-size: 15px;
		line-height: 1.8;
		color: var(--color-text-secondary);
		margin: 0 0 18px;
	}

	.legal-page__inner :global(ul) {
		margin: 0 0 18px;
		padding-left: 22px;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.legal-page__inner :global(li) {
		font-size: 15px;
		line-height: 1.75;
		color: var(--color-text-secondary);
	}

	.legal-page__inner :global(h2) {
		font-family: var(--font-heading);
		font-size: 20px;
		font-weight: 700;
		color: var(--color-text-primary);
		margin: 36px 0 14px;
	}

	.legal-page__inner :global(strong) {
		color: var(--color-text-primary);
	}

	.legal-page__inner :global(a) {
		color: var(--color-primary);
		font-weight: 600;
	}

	/* Tables scroll inside their own box on phones instead of widening the page. */
	.legal-page__inner :global(table) {
		display: block;
		overflow-x: auto;
		width: 100%;
		border-collapse: collapse;
		margin: 0 0 22px;
		font-size: 14px;
		line-height: 1.6;
	}

	.legal-page__inner :global(th),
	.legal-page__inner :global(td) {
		text-align: start;
		vertical-align: top;
		padding: 10px 12px;
		border: 1px solid var(--color-border-light);
		color: var(--color-text-secondary);
		min-width: 120px;
	}

	.legal-page__inner :global(th) {
		background: var(--color-bg-gray);
		color: var(--color-text-primary);
		font-weight: 700;
	}

	.legal-page__inner :global(code) {
		font-size: 13px;
		background: var(--color-bg-gray);
		padding: 1px 5px;
		border-radius: 4px;
		white-space: nowrap;
	}
</style>
