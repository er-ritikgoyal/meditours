---
import iconShield from 'bootstrap-icons/icons/shield-fill-check.svg?raw';
import iconPiggyBank from 'bootstrap-icons/icons/piggy-bank-fill.svg?raw';
import iconMortarboard from 'healthicons/public/icons/svg/outline/people/doctor.svg?raw';
import iconCompass from 'bootstrap-icons/icons/compass-fill.svg?raw';
import iconHeadset from 'bootstrap-icons/icons/headset.svg?raw';
import iconCash from 'bootstrap-icons/icons/cash-coin.svg?raw';

const ICONS = {
	shield: iconShield,
	piggyBank: iconPiggyBank,
	mortarboard: iconMortarboard,
	compass: iconCompass,
	headset: iconHeadset,
	cash: iconCash,
} as const;

export interface Reason {
	icon: keyof typeof ICONS;
	title: string;
	description: string;
	theme?: 'blue' | 'teal' | 'green';
}

export interface Props {
	badge?: string;
	title?: string;
	highlight?: string;
	subtitle?: string;
	reasons?: Reason[];
}

const {
	badge = 'Why Choose Us',
	title = 'The Trusted Choice for',
	highlight = 'Global Patients',
	subtitle = 'Thousands of patients travel with us every year — here is what makes the experience different.',
	reasons = [
		{
			icon: 'shield',
			title: 'JCI & NABH Accredited Hospitals',
			description: 'Every partner hospital meets the same accreditation standards trusted by patients worldwide.',
			theme: 'blue',
		},
		{
			icon: 'piggyBank',
			title: 'Save Up to 80% on Treatment',
			description: 'World-class care at a fraction of Western prices, with no compromise on quality or safety.',
			theme: 'teal',
		},
		{
			icon: 'mortarboard',
			title: 'Globally Trained Specialists',
			description: 'Our medical board hand-picks surgeons trained and certified in the US, UK, and Europe.',
			theme: 'green',
		},
		{
			icon: 'compass',
			title: 'End-to-End Concierge Support',
			description: 'Visas, flights, accommodation, and translators — one coordinator manages your entire journey.',
			theme: 'blue',
		},
		{
			icon: 'headset',
			title: '24/7 Multilingual Support',
			description: 'Reach your care team any time, in your language, before, during, and after treatment.',
			theme: 'teal',
		},
		{
			icon: 'cash',
			title: 'Transparent, No Hidden Costs',
			description: 'A single upfront quote covers your treatment — no surprise bills after you arrive.',
			theme: 'green',
		},
	],
} = Astro.props;
---

<section class="why">
	<div class="why__inner">
		<div class="why__header" data-animate>
			<span class="why__badge">{badge}</span>
			<h2 class="why__title">
				{title} <span>{highlight}</span>
			</h2>
			<p class="why__subtitle">{subtitle}</p>
		</div>

		<div class="why__grid">
			{
				reasons.map((reason, i) => (
					<div class="why-card" data-animate style={`transition-delay: ${(i % 3) * 80}ms`}>
						<span class={`why-card__icon why-card__icon--${reason.theme ?? 'blue'}`} set:html={ICONS[reason.icon]} />
						<h3 class="why-card__title">{reason.title}</h3>
						<p class="why-card__desc">{reason.description}</p>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const animated = document.querySelectorAll('.why [data-animate]');

	if (prefersReducedMotion) {
		animated.forEach((el) => el.classList.add('is-visible'));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 }
		);
		animated.forEach((el) => observer.observe(el));
	}
</script>

<style>
	.why {
		background: var(--color-bg-alt);
		padding: 80px 24px 88px;
		font-family: var(--font-body);
	}

	.why__inner {
		max-width: 1320px;
		margin: 0 auto;
	}

	[data-animate] {
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}

	[data-animate].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.why__header {
		text-align: center;
		max-width: 640px;
		margin: 0 auto 48px;
	}

	.why__badge {
		display: inline-block;
		padding: 7px 18px;
		border-radius: 999px;
		border: 1px solid var(--color-border-card);
		background: var(--color-bg-white);
		color: var(--color-primary);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		margin-bottom: 20px;
	}

	.why__title {
		font-family: var(--font-heading);
		font-size: clamp(1.8rem, 3.2vw, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-text-primary);
		margin: 0;
	}

	.why__title span {
		color: var(--color-teal);
	}

	.why__subtitle {
		margin-top: 14px;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.why__grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.why-card {
		background: var(--color-bg-white);
		border: 1px solid var(--color-border-card);
		border-radius: var(--radius-lg);
		padding: 30px 26px;
		box-shadow: var(--shadow-soft);
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease,
			opacity 0.6s ease;
	}

	.why-card:hover {
		transform: translateY(-6px);
		box-shadow: var(--shadow-card);
	}

	.why-card__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 52px;
		height: 52px;
		border-radius: 14px;
		margin-bottom: 18px;
		color: #ffffff;
	}

	.why-card__icon :global(svg) {
		width: 24px;
		height: 24px;
	}

	.why-card__icon--blue {
		background: linear-gradient(135deg, var(--color-primary) 0%, #2f6fa8 100%);
	}

	.why-card__icon--teal {
		background: linear-gradient(135deg, #0f766e 0%, var(--color-teal) 100%);
	}

	.why-card__icon--green {
		background: linear-gradient(135deg, #15803d 0%, var(--color-green) 100%);
	}

	.why-card__title {
		font-family: var(--font-heading);
		font-size: 17px;
		font-weight: 700;
		color: var(--color-text-primary);
		margin: 0 0 10px;
	}

	.why-card__desc {
		font-size: 14px;
		line-height: 1.6;
		color: var(--color-text-secondary);
		margin: 0;
	}

	@media screen and (max-width: 980px) {
		.why__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media screen and (max-width: 640px) {
		.why {
			padding: 56px 16px 64px;
		}

		.why__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
