---
import iconDocument from 'healthicons/public/icons/svg/outline/specialties/medical_records.svg?raw';
import iconOpinion from 'healthicons/public/icons/svg/outline/people/doctor.svg?raw';
import iconIdCard from 'bootstrap-icons/icons/person-vcard.svg?raw';
import iconPlane from 'bootstrap-icons/icons/airplane.svg?raw';
import iconCar from 'bootstrap-icons/icons/car-front.svg?raw';
import iconBuilding from 'healthicons/public/icons/svg/outline/places/hospital.svg?raw';
import iconHome from 'bootstrap-icons/icons/house-door.svg?raw';
import iconConnector from 'bootstrap-icons/icons/chevron-double-right.svg?raw';

export interface Step {
	title: string;
	description: string;
	icon: keyof typeof ICONS;
}

export interface Props {
	badge?: string;
	title?: string;
	highlight?: string;
	subtitle?: string;
	steps?: Step[];
}

const ICONS = {
	document: iconDocument,
	stethoscope: iconOpinion,
	idCard: iconIdCard,
	plane: iconPlane,
	car: iconCar,
	building: iconBuilding,
	home: iconHome,
} as const;

const {
	badge = 'Step-by-Step Guide',
	title = 'Overseas Patient',
	highlight = 'Travel Process',
	subtitle = 'From your first query to returning home — we are with you at every step',
	steps = [
		{
			title: 'Provide Patient Medical Details',
			description: 'Share reports & query — get a relevant opinion within 24 hours.',
			icon: 'document',
		},
		{
			title: 'Get Medical Opinion & Cost Estimation',
			description: 'Choose freely from our top empanelled hospitals & doctors.',
			icon: 'stethoscope',
		},
		{
			title: 'Receive Visa Invite From Us',
			description: 'We handle all medical visa formalities on your behalf.',
			icon: 'idCard',
		},
		{
			title: 'Schedule Your Travel',
			description: 'Hotel, apartment or guest house arranged near the hospital.',
			icon: 'plane',
		},
		{
			title: 'Received at Airport by Us',
			description: 'Complimentary airport pickup, drop & SIM card provided.',
			icon: 'car',
		},
		{
			title: 'Get Treated',
			description: 'Dedicated interpreter & case manager with you throughout.',
			icon: 'building',
		},
		{
			title: 'Travel Back to Home',
			description: 'Post-treatment follow-up assistance after returning home.',
			icon: 'home',
		},
	],
} = Astro.props;
---

<section class="process">
	<div class="process__inner">
		<div class="process__header">
			<span class="process__badge">{badge}</span>
			<h2 class="process__title">
				{title} <span>{highlight}</span>
			</h2>
			<p class="process__subtitle">{subtitle}</p>
		</div>

		<ol class="process__steps">
			{
				steps.map((step, i) => (
					<>
						<li class="process__step">
							<span class="process__number">{i + 1}</span>
							<span class="process__icon" set:html={ICONS[step.icon]} />
							<h3 class="process__step-title">{step.title}</h3>
							<p class="process__step-desc">{step.description}</p>
						</li>
						{i < steps.length - 1 && (
							<li class="process__connector" aria-hidden="true" set:html={iconConnector} />
						)}
					</>
				))
			}
		</ol>
	</div>
</section>

<style>
	.process {
		background: var(--color-bg-alt);
		padding: 72px 24px;
		font-family: var(--font-body);
	}

	.process__inner {
		max-width: 1320px;
		margin: 0 auto;
	}

	.process__header {
		text-align: center;
		max-width: 640px;
		margin: 0 auto 56px;
	}

	.process__badge {
		display: inline-block;
		padding: 7px 18px;
		border-radius: 999px;
		border: 1px solid var(--color-border-card);
		background: #ffffff;
		color: var(--color-primary);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		margin-bottom: 20px;
	}

	.process__title {
		font-family: var(--font-heading);
		font-size: clamp(1.8rem, 3.2vw, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-text-primary);
		margin: 0;
	}

	.process__title span {
		color: var(--color-teal);
	}

	.process__subtitle {
		margin-top: 14px;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.process__steps {
		display: flex;
		align-items: flex-start;
		gap: clamp(2px, 0.8vw, 10px);
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.process__step {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		flex: 1 1 0%;
		min-width: 0;
		padding-top: 12px;
	}

	.process__connector {
		flex: 0 0 auto;
		display: flex;
		align-items: center;
		justify-content: center;
		height: clamp(40px, 6vw, 72px);
		margin-top: 12px;
		color: var(--color-teal);
		opacity: 0.5;
	}

	/* Double-chevron points in reading direction; mirror it for RTL. */
	:global(html[dir='rtl']) .process__connector {
		transform: scaleX(-1);
	}

	.process__connector :global(svg) {
		width: clamp(11px, 1.5vw, 18px);
		height: clamp(11px, 1.5vw, 18px);
	}

	.process__number {
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(clamp(10px, 2vw, 20px));
		width: 20px;
		height: 20px;
		border-radius: 50%;
		background: var(--gradient-cta);
		color: #ffffff;
		font-size: 11px;
		font-weight: 700;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.process__icon {
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
		width: clamp(40px, 6vw, 72px);
		height: clamp(40px, 6vw, 72px);
		border-radius: 50%;
		background: #ffffff;
		border: 1px solid var(--color-border-card);
		color: var(--color-primary);
		margin-bottom: clamp(8px, 1.6vw, 18px);
		flex-shrink: 0;
		box-shadow: var(--shadow-soft);
	}

	.process__icon :global(svg) {
		width: 45%;
		height: 45%;
	}

	.process__step-title {
		font-size: clamp(10px, 1.15vw, 15px);
		font-weight: 700;
		color: var(--color-text-primary);
		line-height: 1.35;
		margin: 0 0 8px;
		overflow-wrap: break-word;
	}

	.process__step-desc {
		font-size: clamp(9px, 0.95vw, 13px);
		line-height: 1.5;
		color: var(--color-text-muted);
		margin: 0;
	}

	@media screen and (max-width: 900px) {
		.process {
			padding: 56px 16px;
		}

		.process__step-desc {
			display: none;
		}
	}

	@media screen and (max-width: 768px) {
		.process__steps {
			display: grid;
			grid-template-columns: repeat(2, 1fr);
			gap: 36px 16px;
		}

		.process__step {
			flex: none;
			padding-top: 16px;
		}

		.process__connector {
			display: none;
		}

		.process__number {
			transform: translateX(22px);
			width: 22px;
			height: 22px;
			font-size: 12px;
		}

		.process__icon {
			width: 56px;
			height: 56px;
			margin-bottom: 12px;
		}

		.process__step-title {
			font-size: 14px;
		}

		.process__step-desc {
			display: block;
			font-size: 12.5px;
		}
	}

	@media screen and (max-width: 420px) {
		.process__steps {
			grid-template-columns: 1fr;
			max-width: 320px;
			margin: 0 auto;
		}
	}
</style>
