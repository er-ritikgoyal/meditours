---
import iconTicket from 'bootstrap-icons/icons/ticket-perforated-fill.svg?raw';
import iconEscort from 'bootstrap-icons/icons/life-preserver.svg?raw';
import iconCompanion from 'bootstrap-icons/icons/person-plus-fill.svg?raw';
import iconPassport from 'bootstrap-icons/icons/passport-fill.svg?raw';
import iconCheck from 'bootstrap-icons/icons/check-circle-fill.svg?raw';
import iconArrow from 'bootstrap-icons/icons/arrow-right-short.svg?raw';

export interface ServiceContent {
	name: string;
	description: string;
	features: string[];
}

export interface Props {
	badge?: string;
	titleLead?: string;
	titleHighlight?: string;
	subtitle?: string;
	services?: ServiceContent[];
	ctaLabel?: string;
}

const serviceIcons = [iconTicket, iconEscort, iconCompanion, iconPassport];
const serviceThemes = ['blue', 'teal', 'green', 'blue'] as const;

const {
	badge = 'Travel Support',
	titleLead = 'Flight Services Built',
	titleHighlight = 'Around Your Care',
	subtitle = 'From the first booking to landing back home, your coordinator handles every travel detail.',
	services: servicesProp = [
		{
			name: 'Flight Booking Assistance',
			description: 'Our travel desk finds and books the best fares across partner airlines, timed around your treatment schedule.',
			features: ['Fare comparison across airlines', 'Treatment-schedule-aligned timing', 'Group booking for family'],
		},
		{
			name: 'Medical Escort & Stretcher Flights',
			description: 'For patients who need in-flight medical supervision, we arrange escorted or stretcher-configured flights.',
			features: ['Onboard nurse or paramedic', 'Stretcher-class seating', 'Oxygen & equipment coordination'],
		},
		{
			name: 'Companion & Attendant Tickets',
			description: 'Discounted attendant fares and synchronized itineraries so a family member can travel alongside you.',
			features: ['Discounted companion fares', 'Synchronized seating & layovers', 'Shared itinerary management'],
		},
		{
			name: 'Visa & Travel Documentation',
			description: 'End-to-end support for medical visas, hospital invitation letters, and travel document verification.',
			features: ['Medical visa invitation letters', 'Document checklist & review', 'Embassy appointment support'],
		},
	],
	ctaLabel = 'Enquire Now',
} = Astro.props;

const services = servicesProp.map((service, i) => ({ ...service, icon: serviceIcons[i], theme: serviceThemes[i] }));
---

<section class="flight-services">
	<div class="flight-services__inner">
		<div class="flight-services__header" data-animate>
			<span class="flight-services__badge">{badge}</span>
			<h2 class="flight-services__title">
				{titleLead} <span>{titleHighlight}</span>
			</h2>
			<p class="flight-services__subtitle">
				{subtitle}
			</p>
		</div>

		<div class="flight-services__grid">
			{
				services.map((service, i) => (
					<div class={`service-card service-card--${service.theme}`} data-animate style={`transition-delay: ${i * 100}ms`}>
						<span class="service-card__icon" set:html={service.icon} aria-hidden="true" />
						<h3 class="service-card__name">{service.name}</h3>
						<p class="service-card__desc">{service.description}</p>
						<ul class="service-card__features">
							{service.features.map((feature) => (
								<li>
									<span set:html={iconCheck} aria-hidden="true" />
									{feature}
								</li>
							))}
						</ul>
						<a class="service-card__cta" href="/contact">
							{ctaLabel}
							<span set:html={iconArrow} aria-hidden="true" />
						</a>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const animated = document.querySelectorAll('.flight-services [data-animate]');

	if (prefersReducedMotion) {
		animated.forEach((el) => el.classList.add('is-visible'));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 }
		);
		animated.forEach((el) => observer.observe(el));
	}
</script>

<style>
	.flight-services {
		background: var(--color-bg-white);
		padding: 80px 24px;
		font-family: var(--font-body);
	}

	.flight-services__inner {
		max-width: 1240px;
		margin: 0 auto;
	}

	[data-animate] {
		opacity: 0;
		transform: translateY(24px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}

	[data-animate].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.flight-services__header {
		text-align: center;
		max-width: 620px;
		margin: 0 auto 48px;
	}

	.flight-services__badge {
		display: inline-block;
		padding: 7px 18px;
		border-radius: 999px;
		border: 1px solid var(--color-border-card);
		background: var(--color-bg-soft-blue);
		color: var(--color-primary);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		margin-bottom: 20px;
	}

	.flight-services__title {
		font-family: var(--font-heading);
		font-size: clamp(1.8rem, 3.2vw, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-text-primary);
		margin: 0;
	}

	.flight-services__title span {
		color: var(--color-teal);
	}

	.flight-services__subtitle {
		margin-top: 14px;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.flight-services__grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 28px;
	}

	.service-card {
		display: flex;
		flex-direction: column;
		padding: 32px 28px;
		background: var(--color-bg-white);
		border: 1px solid var(--color-border-card);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-soft);
		transition:
			transform 0.25s ease,
			box-shadow 0.25s ease;
	}

	.service-card:hover {
		transform: translateY(-8px);
		box-shadow: var(--shadow-card);
	}

	.service-card__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 56px;
		height: 56px;
		border-radius: 16px;
		margin-bottom: 20px;
		color: #ffffff;
	}

	.service-card__icon :global(svg) {
		width: 26px;
		height: 26px;
	}

	.service-card--blue .service-card__icon {
		background: linear-gradient(135deg, var(--color-primary) 0%, #2f6fa8 100%);
	}

	.service-card--teal .service-card__icon {
		background: linear-gradient(135deg, #0f766e 0%, var(--color-teal) 100%);
	}

	.service-card--green .service-card__icon {
		background: linear-gradient(135deg, #15803d 0%, var(--color-green) 100%);
	}

	.service-card__name {
		font-family: var(--font-heading);
		font-size: 19px;
		font-weight: 700;
		color: var(--color-text-primary);
		margin: 0 0 10px;
	}

	.service-card__desc {
		font-size: 13.5px;
		line-height: 1.6;
		color: var(--color-text-secondary);
		margin: 0 0 20px;
	}

	.service-card__features {
		display: flex;
		flex-direction: column;
		gap: 12px;
		list-style: none;
		margin: 0 0 26px;
		padding: 0;
		flex: 1;
	}

	.service-card__features li {
		display: flex;
		align-items: flex-start;
		gap: 8px;
		font-size: 13.5px;
		line-height: 1.5;
		color: var(--color-text-secondary);
	}

	.service-card__features li span {
		display: flex;
		flex-shrink: 0;
		width: 15px;
		height: 15px;
		margin-top: 2px;
		color: var(--color-green);
	}

	.service-card__features li span :global(svg) {
		width: 100%;
		height: 100%;
	}

	.service-card__cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 2px;
		margin-top: auto;
		padding: 12px 20px;
		border-radius: var(--radius-md);
		background: var(--btn-secondary-bg);
		border: 1px solid var(--btn-secondary-border);
		color: var(--btn-secondary-text);
		font-size: 14px;
		font-weight: 600;
		text-decoration: none;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}

	.service-card__cta:hover {
		background: var(--btn-secondary-hover-bg);
	}

	@media screen and (max-width: 900px) {
		.flight-services__grid {
			grid-template-columns: 1fr;
			max-width: 460px;
			margin: 0 auto;
		}
	}

	@media screen and (max-width: 640px) {
		.flight-services {
			padding: 56px 16px;
		}
	}
</style>
