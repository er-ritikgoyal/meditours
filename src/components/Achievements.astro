---
/**
 * Four full-bleed "achievement" stat cards, each with a photo background.
 * Lives Impacted and Accredited Hospitals cross-fade through several photos
 * via Swiper (manually swipeable + autoplay); the other two use a single image.
 */
import 'swiper/css';
import 'swiper/css/effect-fade';
import { Image } from 'astro:assets';
import Globe from '../assets/hospitals/world_map.png';
import imgAnu1 from '../assets/hospitals/anu1.jpeg';
import imgAnu2 from '../assets/hospitals/anu2.jpeg';
import imgAnu3 from '../assets/hospitals/anu3.jpeg';
import imgAnu4 from '../assets/hospitals/anu4.jpeg';
import img5years from '../assets/hospitals/5_years.jpg';
import imgMarengoAsia from '../assets/hospitals/marengo-asia-hospitals.webp';
import imgBlkMax from '../assets/hospitals/blk-max.webp';
import imgMaxNoida from '../assets/hospitals/max-super-speciality-hospital-noida.jpg';
import imgFortisShalimarBagh from '../assets/hospitals/fortis-hospital-shalimar-bagh.webp';

export interface AchievementLabels {
	countriesTouched: string;
	livesImpacted: string;
	yearsOfExcellence: string;
	accreditedHospitals: string;
}

export interface Props {
	badge?: string;
	title?: string;
	highlight?: string;
	subtitle?: string;
	labels?: AchievementLabels;
}

const {
	badge = 'Our Impact',
	title = 'Numbers That',
	highlight = 'Speak for Themselves',
	subtitle = 'Over 5 years of coordinating world-class care, measured in the patients we have helped.',
	labels = {
		countriesTouched: 'Countries Touched',
		livesImpacted: 'Lives Impacted',
		yearsOfExcellence: 'Years of Excellence',
		accreditedHospitals: 'Accredited Hospitals',
	},
} = Astro.props;

const livesImpactedImages = [imgAnu1, imgAnu2, imgAnu3, imgAnu4];
const accreditedHospitalImages = [imgMarengoAsia, imgBlkMax, imgMaxNoida, imgFortisShalimarBagh];

const cards = [
	{ type: 'image' as const, image: Globe, value: '40+', label: labels.countriesTouched },
	{ type: 'swiper' as const, images: livesImpactedImages, value: '10,000+', label: labels.livesImpacted },
	{ type: 'image' as const, image: img5years, value: '5+', label: labels.yearsOfExcellence },
	{ type: 'swiper' as const, images: accreditedHospitalImages, value: '100+', label: labels.accreditedHospitals },
];
---

<section class="achievements">
	<div class="achievements__inner">
		<div class="achievements__header" data-animate>
			<span class="achievements__badge">{badge}</span>
			<h2 class="achievements__title">
				{title} <span>{highlight}</span>
			</h2>
			<p class="achievements__subtitle">{subtitle}</p>
		</div>

		<div class="achievements__grid">
			{
				cards.map((card, i) => (
					<div class="achievement-card" data-animate style={`transition-delay: ${i * 90}ms`}>
						{card.type === 'image' && (
							<Image src={card.image} alt="" width={420} height={520} class="achievement-card__bg-img" />
						)}

						{card.type === 'swiper' && (
							<div class="achievement-card__swiper swiper">
								<div class="swiper-wrapper">
									{card.images.map((img) => (
										<div class="swiper-slide">
											<Image src={img} alt="" width={420} height={520} class="achievement-card__bg-img" />
										</div>
									))}
								</div>
							</div>
						)}

						<div class="achievement-card__content">
							<strong class="achievement-card__value">{card.value}</strong>
							<span class="achievement-card__label">{card.label}</span>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	import Swiper from 'swiper';
	import { Autoplay, EffectFade } from 'swiper/modules';

	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	document.querySelectorAll('.achievement-card__swiper').forEach((el) => {
		new Swiper(el as HTMLElement, {
			modules: [Autoplay, EffectFade],
			effect: 'fade',
			fadeEffect: { crossFade: true },
			loop: true,
			allowTouchMove: true,
			grabCursor: true,
			speed: 1200,
			autoplay: prefersReducedMotion ? false : { delay: 2600, disableOnInteraction: false },
		});
	});

	// Scroll-reveal — same [data-animate] pattern used across the site.
	const animated = document.querySelectorAll('.achievements [data-animate]');
	if (prefersReducedMotion) {
		animated.forEach((el) => el.classList.add('is-visible'));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 },
		);
		animated.forEach((el) => observer.observe(el));
	}
</script>

<style>
	.achievements {
		background: var(--color-bg-alt);
		padding: 80px 24px 88px;
		font-family: var(--font-body);
	}

	.achievements__inner {
		max-width: 1180px;
		margin: 0 auto;
	}

	[data-animate] {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}

	[data-animate].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.achievements__header {
		text-align: center;
		max-width: 640px;
		margin: 0 auto 40px;
	}

	.achievements__badge {
		display: inline-block;
		font-size: 13px;
		font-weight: 700;
		color: var(--color-teal);
		background: var(--color-bg-soft-blue);
		padding: 6px 16px;
		border-radius: 999px;
		margin-bottom: 14px;
	}

	.achievements__title {
		font-family: var(--font-heading);
		font-size: 32px;
		font-weight: 700;
		color: var(--color-text-primary);
		margin: 0 0 12px;
	}

	.achievements__title span {
		color: var(--color-primary);
	}

	.achievements__subtitle {
		font-size: 15px;
		line-height: 1.7;
		color: var(--color-text-secondary);
		margin: 0;
	}

	.achievements__grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
	}

	.achievement-card {
		position: relative;
		aspect-ratio: 3 / 4;
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-card);
		isolation: isolate;
		background: var(--color-text-primary);
		border: 1px solid rgba(255, 255, 255, 0.4);
	}

	.achievement-card__swiper {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.achievement-card__bg-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.achievement-card__content {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		z-index: 2;
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 34px 18px 20px;
		background: linear-gradient(to top, rgba(15, 23, 42, 0.78) 0%, rgba(15, 23, 42, 0.5) 65%, rgba(15, 23, 42, 0) 100%);
	}

	.achievement-card__value {
		font-family: var(--font-heading);
		font-size: 30px;
		font-weight: 800;
		color: #ffffff;
		line-height: 1.1;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.65);
	}

	.achievement-card__label {
		font-size: 13.5px;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.95);
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.65);
	}

	@media screen and (max-width: 860px) {
		.achievements__grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media screen and (max-width: 520px) {
		.achievements {
			padding: 56px 16px 64px;
		}

		.achievements__title {
			font-size: 26px;
		}

		.achievement-card {
			aspect-ratio: 4 / 3;
		}
	}
</style>
