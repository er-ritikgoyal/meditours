---
import iconChevron from 'bootstrap-icons/icons/chevron-down.svg?raw';

export interface FaqItem {
	question: string;
	answer: string;
}

export interface Props {
	badge?: string;
	title?: string;
	highlight?: string;
	subtitle?: string;
	faqs?: FaqItem[];
}

const {
	badge = 'FAQs',
	title = 'Questions,',
	highlight = 'Answered',
	subtitle = "Can't find what you're looking for? Reach out and a coordinator will get back to you directly.",
	faqs = [
		{
			question: 'Is it safe to travel to India for medical treatment?',
			answer:
				'Yes. Every partner hospital is JCI or NABH accredited — the same standards held by leading hospitals in the US, UK, and Europe. Our medical board also reviews every case before it is matched to a specialist.',
		},
		{
			question: 'How do I get a medical visa?',
			answer:
				'Once your treatment is confirmed, our visa specialists prepare your medical visa invitation letter and guide you through the entire application — most patients receive approval within a few business days.',
		},
		{
			question: 'What happens if I need follow-up care after returning home?',
			answer:
				'Your dedicated coordinator stays in touch after you return home, coordinating with your local doctor and the treating hospital for any follow-up questions, reports, or complications.',
		},
		{
			question: 'How are your partner hospitals and doctors selected?',
			answer:
				'Every hospital must hold JCI or NABH accreditation, and every specialist is vetted by our in-house medical board for training, case volume, and patient outcomes before being added to our network.',
		},
		{
			question: 'Does the initial consultation cost anything?',
			answer:
				'No. Sharing your medical reports and receiving a treatment plan with transparent pricing is completely free, with no obligation to proceed.',
		},
		{
			question: 'Do you help with accommodation and travel arrangements?',
			answer:
				'Yes. Your coordinator arranges flights, accommodation near the hospital, airport pickup, and an interpreter if needed, so you can focus entirely on your treatment and recovery.',
		},
	],
} = Astro.props;
---

<section class="faq">
	<div class="faq__inner">
		<div class="faq__header" data-animate>
			<span class="faq__badge">{badge}</span>
			<h2 class="faq__title">
				{title} <span>{highlight}</span>
			</h2>
			<p class="faq__subtitle">{subtitle}</p>
		</div>

		<div class="faq__list">
			{
				faqs.map((faq, i) => (
					<div class="faq-item" data-animate style={`transition-delay: ${(i % 4) * 60}ms`}>
						<button class="faq-item__question" data-faq-trigger aria-expanded="false">
							{faq.question}
							<span class="faq-item__icon" set:html={iconChevron} aria-hidden="true" />
						</button>
						<div class="faq-item__answer-wrap">
							<div class="faq-item__answer-inner">
								<p class="faq-item__answer">{faq.answer}</p>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>

<script>
	const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const animated = document.querySelectorAll('.faq [data-animate]');

	if (prefersReducedMotion) {
		animated.forEach((el) => el.classList.add('is-visible'));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15 }
		);
		animated.forEach((el) => observer.observe(el));
	}

	const triggers = document.querySelectorAll<HTMLButtonElement>('[data-faq-trigger]');

	triggers.forEach((trigger) => {
		trigger.addEventListener('click', () => {
			const item = trigger.closest('.faq-item');
			const isOpen = item?.classList.contains('is-open');

			triggers.forEach((t) => {
				t.closest('.faq-item')?.classList.remove('is-open');
				t.setAttribute('aria-expanded', 'false');
			});

			if (!isOpen) {
				item?.classList.add('is-open');
				trigger.setAttribute('aria-expanded', 'true');
			}
		});
	});
</script>

<style>
	.faq {
		background: var(--color-bg-white);
		padding: 80px 24px;
		font-family: var(--font-body);
	}

	.faq__inner {
		max-width: 780px;
		margin: 0 auto;
	}

	[data-animate] {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity 0.6s ease,
			transform 0.6s ease;
	}

	[data-animate].is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	.faq__header {
		text-align: center;
		max-width: 560px;
		margin: 0 auto 48px;
	}

	.faq__badge {
		display: inline-block;
		padding: 7px 18px;
		border-radius: 999px;
		border: 1px solid var(--color-border-card);
		background: var(--color-bg-soft-blue);
		color: var(--color-primary);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		margin-bottom: 20px;
	}

	.faq__title {
		font-family: var(--font-heading);
		font-size: clamp(1.7rem, 3vw, 2.3rem);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-text-primary);
		margin: 0;
	}

	.faq__title span {
		color: var(--color-teal);
	}

	.faq__subtitle {
		margin-top: 14px;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--color-text-secondary);
	}

	.faq__list {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.faq-item {
		border: 1px solid var(--color-border-card);
		border-radius: var(--radius-md);
		background: var(--color-bg-white);
		overflow: hidden;
		transition: box-shadow 0.2s ease;
	}

	.faq-item.is-open {
		box-shadow: var(--shadow-soft);
		border-color: var(--color-teal);
	}

	.faq-item__question {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		width: 100%;
		padding: 18px 20px;
		border: none;
		background: transparent;
		text-align: start;
		font-family: var(--font-heading);
		font-size: 15px;
		font-weight: 600;
		color: var(--color-text-primary);
		cursor: pointer;
	}

	.faq-item__icon {
		display: flex;
		flex-shrink: 0;
		width: 18px;
		height: 18px;
		color: var(--color-teal);
		transition: transform 0.25s ease;
	}

	.faq-item__icon :global(svg) {
		width: 100%;
		height: 100%;
	}

	.faq-item.is-open .faq-item__icon {
		transform: rotate(180deg);
	}

	.faq-item__answer-wrap {
		display: grid;
		grid-template-rows: 0fr;
		transition: grid-template-rows 0.3s ease;
	}

	.faq-item.is-open .faq-item__answer-wrap {
		grid-template-rows: 1fr;
	}

	.faq-item__answer-inner {
		overflow: hidden;
	}

	.faq-item__answer {
		margin: 0;
		padding: 0 20px 18px;
		font-size: 14px;
		line-height: 1.65;
		color: var(--color-text-secondary);
	}

	@media screen and (max-width: 640px) {
		.faq {
			padding: 56px 16px;
		}

		.faq-item__question {
			padding: 16px;
			font-size: 14px;
		}
	}
</style>
